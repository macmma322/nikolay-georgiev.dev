{
  "name": "nikolay-georgiev-portfolio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Engineering portfolio of Nikolay Georgiev, built with Astro and TypeScript.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:i18n && astro build && node scripts/audit-dist.mjs",
    "check:i18n": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-i18n.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:dist": "node scripts/audit-dist.mjs",
    "test:e2e": "playwright test",
    "og": "astro build && node scripts/og.mjs && npm run build",
    "cv": "node scripts/cv.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/hubot-sans": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/tiktok-sans": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.33.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "playwright-core": "$@playwright/test"
  }
}
