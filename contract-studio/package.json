{
  "name": "contract-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private single-user contract workspace. Deployed on its own, never bundled with the public portfolio.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --env-file=.env --watch src/server.ts",
    "migrate": "node src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@expo-google-fonts/noto-serif": "0.4.2",
    "@fontsource-variable/hubot-sans": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/tiktok-sans": "^5.3.0",
    "@hono/node-server": "^1.19.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/server": "14.1.0",
    "docx": "9.15.3",
    "hono": "4.13.17",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "18.6.0-beta.19",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^6.0.3"
  }
}
