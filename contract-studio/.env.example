# Local development only. Production values live in Railway variables.
# Copy to .env (git-ignored). Full reference: docs/contract-studio/08-environment-variables.md
DATABASE_URL=postgres://studio:change-me@127.0.0.1:5432/contract_studio
APP_ORIGIN=http://localhost:18787
RP_ID=localhost
# Leave empty locally. Set in production; Caddy must send the same value.
PROXY_SHARED_SECRET=
# One-time token that allows enrolling a passkey at /workspace/contracts/setup.
SETUP_TOKEN=
DOCUMENT_DIR=./.data/documents
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
