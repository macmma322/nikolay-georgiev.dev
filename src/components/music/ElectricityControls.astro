---
import { useI18n } from '@/i18n';
import { electricity } from '@/i18n/ui/electricity';
const { t } = useI18n(Astro);
const s = t(electricity);
interface Props {
  sources?: readonly { label: string; url: string }[];
}
const { sources = [] } = Astro.props;
// Only repository-configured, HTTPS or same-origin media can be offered here.
const approved = sources.filter(({ url }) => {
  const parsed = new URL(url, Astro.url);
  return parsed.origin === Astro.url.origin || parsed.protocol === 'https:';
});
const origins = [...new Set(approved.map(({ url }) => new URL(url, Astro.url).origin))].filter(
  (origin) => origin !== Astro.url.origin,
);
Astro.csp?.insertDirective(
  `media-src 'self' blob:${origins.length ? ' ' + origins.join(' ') : ''}`,
);
---

<electricity-controls
  class="electricity"
  data-running={s.running}
  data-paused={s.paused}
  data-pause={s.pause}
  data-resume={s.resume}
  data-unavailable={s.unavailable}
  data-ended={s.ended}
>
  <details>
    <summary title={s.label}>
      <svg
        viewBox="0 0 24 24"
        width="19"
        height="19"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <path d="M4 6h16M4 12h16M4 18h16" />
        <circle cx="8" cy="6" r="2" />
        <circle cx="15" cy="12" r="2" />
        <circle cx="10" cy="18" r="2" />
      </svg>
      <span class="visually-hidden">{s.label}</span>
    </summary>
    <div class="controls">
      <label class="setting">
        <span>{s.mode}</span>
        <select data-mode aria-describedby="electricity-player-help">
          <option value="ambient">{s.ambient}</option>
          <option value="player">{s.player}</option>
          <option value="live">{s.live}</option>
        </select>
      </label>
      <label class="setting">
        <span>{s.strength}</span>
        <select data-intensity>
          <option value="0.65">{s.low}</option>
          <option value="1" selected>
            {s.medium}
          </option>
          <option value="1.25">{s.high}</option>
        </select>
      </label>
      <label class="setting">
        <span>{s.quality}</span>
        <select data-quality>
          <option value="auto" selected>
            {s.qualityAuto}
          </option>
          <option value="high">{s.qualityHigh}</option>
          <option value="balanced">{s.qualityBalanced}</option>
          <option value="low">{s.qualityLow}</option>
        </select>
      </label>
      <p id="electricity-player-help">{s.playerHelp}</p>
      <div class="sources" data-live-sources hidden>
        <p>{s.sourceHelp}</p>
        <button data-demo type="button">
          {s.demo}
        </button>
        <label>
          <span>{s.file}</span>
          <input data-local-file type="file" accept="audio/*" />
        </label>
      </div>
      <p class="notice" data-audio-notice role="status"></p>
    </div>
  </details>
  <div class="audio-dock" data-audio-dock hidden>
    <span data-active-audio>{s.running}</span>
    <button type="button" data-audio-toggle>
      {s.pause}
    </button>
    <button type="button" data-audio-stop>
      {s.stop}
    </button>
  </div>
</electricity-controls>

<script>
  import '@/scripts/electricity-controls';
</script>

<style>
  .electricity {
    --controls-bottom: calc(100% + 0.5rem);
    position: relative;
    flex: 0 0 44px;
    color: var(--fg-2);
  }

  :global(html:not([data-js])) .electricity {
    display: none;
  }

  [hidden] {
    display: none !important;
  }

  summary {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid #645043;
    border-radius: 6px;
    background: #201917;
    color: #e6b894;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary circle {
    fill: #201917;
  }

  details[open] summary,
  summary:hover {
    background: #34261f;
  }

  .controls,
  .sources,
  .sources label {
    display: grid;
    gap: 0.55rem;
  }

  .controls {
    position: absolute;
    inset: auto 0 var(--controls-bottom) auto;
    width: min(19.5rem, calc(100vw - 1.5rem));
    max-height: max(5rem, calc(100dvh - var(--header-h) - var(--music-dock-clearance) - 2rem));
    overflow: auto;
    padding: 0.7rem;
    border: 1px solid #795a46;
    border-radius: 6px;
    background: #1b1617;
    box-shadow: 0 4px 22px #0008;
  }

  .electricity:has(.audio-dock:not([hidden])) {
    --controls-bottom: calc(100% + 3.8rem);
  }

  .electricity:has(.audio-dock:not([hidden])) .controls {
    max-height: max(5rem, calc(100dvh - var(--header-h) - var(--music-dock-clearance) - 5rem));
  }

  .setting {
    display: grid;
    grid-template-columns: minmax(5.2rem, max-content) minmax(0, 1fr);
    gap: 0.55rem;
    align-items: center;
    font-size: var(--text-caption);
  }

  select,
  button,
  input::file-selector-button {
    border: 1px solid #795a46;
    border-radius: 4px;
    color: var(--fg);
    background: #302320;
    font: inherit;
    min-height: 38px;
    padding: 0.35rem 0.55rem;
  }

  select,
  input {
    min-width: 0;
    max-width: 100%;
    color-scheme: dark;
  }

  button,
  input::file-selector-button {
    cursor: pointer;
  }

  p,
  .sources {
    margin: 0;
    font-size: var(--text-caption);
  }

  .notice {
    color: #e6b894;
    padding-top: 0.25rem;
  }

  .notice:empty {
    padding: 0;
  }

  .audio-dock {
    position: absolute;
    inset: auto 0 calc(100% + 0.5rem) auto;
    display: flex;
    white-space: nowrap;
    gap: 0.35rem;
    align-items: center;
    width: max-content;
    max-width: calc(100vw - 1.5rem);
    padding: 0.4rem;
    border: 1px solid #947159;
    border-radius: 6px;
    background: #191417;
    box-shadow: 0 4px 22px #0008;
    font-size: var(--text-caption);
  }

  @media (max-width: 30rem) {
    .audio-dock span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }

  .audio-dock span {
    padding-inline: 0.4rem;
    color: #e6b894;
  }
</style>
