---
import VinylArtwork from './VinylArtwork.astro';
import ElectricityControls from './ElectricityControls.astro';
import CircuitBackdrop from '@/components/layout/CircuitBackdrop.astro';
import { useI18n } from '@/i18n';
import { music } from '@/i18n/ui/music';
import { tracks, youtube } from '@/lib/music';

const { locale, t } = useI18n(Astro);
const s = t(music);
const track = tracks[0];
const { title, artist } = track;

// Explicit sources replace Astro's default. Keep first-party module chunks available.
Astro.csp?.insertScriptResource("'self'");
Astro.csp?.insertScriptResource(youtube.api);
Astro.csp?.insertScriptResource(youtube.widgetScripts);
Astro.csp?.insertDirective(`frame-src ${youtube.embedOrigin}`);
---

<music-experience class="music-shelf" data-locale={locale} data-track-accent={track.accent}>
  <div class="music-dock">
    <section class="shelf-inner" aria-label={s.feature}>
      <a
        class="music-card"
        data-music-launch
        href={youtube.watch(track)}
        aria-labelledby="music-open music-track music-artist"
      >
        <span class="card-art">
          <VinylArtwork />
        </span>
        <span class="card-copy">
          <span class="overline">{s.feature}</span>
          <span class="track" id="music-track" lang="en" data-track-title>
            {title}
          </span>
          <span class="artist" id="music-artist" lang="en" data-track-artist>
            {artist}
          </span>
        </span>
        <span class="card-action">
          <span class="play-icon" aria-hidden="true"></span>
          <span class="source">YouTube</span>
        </span>
        <span class="visually-hidden" id="music-open">
          {s.open}
        </span>
      </a>
    </section>
    <ElectricityControls />
  </div>

  <dialog class="music-panel" id="music-panel" aria-labelledby="music-panel-title">
    <div class="panel-interior">
      <header class="panel-header">
        <CircuitBackdrop place="panel" />
        <div class="panel-art">
          <VinylArtwork />
        </div>
        <div class="panel-copy">
          <p class="overline">{s.selection}</p>
          <h2 class="panel-title" id="music-panel-title" lang="en" data-track-title>
            {title}
          </h2>
          <p class="artist" lang="en" data-track-artist>
            {artist}
          </p>
        </div>
        <button type="button" class="panel-close" data-music-close aria-label={s.close} autofocus>
          <span aria-hidden="true"></span>
        </button>
      </header>

      <label class="track-choice">
        <span>{s.choose}</span>
        <select data-track-select>
          {tracks.map((item) => (
            <option value={item.videoId} lang="en">
              {item.title} — {item.artist}
            </option>
          ))}
        </select>
      </label>

      <div class="screen" data-music-screen>
        <div class="player-slot" data-music-player></div>
        <div
          class="fallback-card"
          data-music-fallback
          hidden
          data-restricted={s.fallback.restricted}
          data-config-blocked={s.fallback.configBlocked}
          data-unavailable={s.fallback.unavailable}
          data-error={s.fallback.error}
          data-unsupported={s.fallback.unsupported}
        >
          <span class="fallback-disc" aria-hidden="true"></span>
          <div class="fallback-copy">
            <p class="fallback-title" lang="en" data-track-title>
              {title}
            </p>
            <p class="fallback-artist" lang="en" data-track-artist>
              {artist}
            </p>
            <p class="fallback-reason" data-fallback-reason></p>
            <a
              class="fallback-action"
              data-fallback-watch
              href={youtube.watch(track)}
              target="_blank"
              rel="noopener"
            >
              {s.listen}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>

      <div class="panel-meta">
        <p
          class="player-status"
          data-music-status
          role="status"
          data-loading={s.status.loading}
          data-ready={s.status.ready}
          data-playing={s.status.playing}
          data-paused={s.status.paused}
          data-buffering={s.status.buffering}
          data-ended={s.status.ended}
          data-restricted={s.status.restricted}
          data-unavailable={s.status.unavailable}
          data-error={s.status.error}
          data-unsupported={s.status.unsupported}
        ></p>
        <a class="watch" data-watch href={youtube.watch(track)} target="_blank" rel="noopener">
          {s.watch}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="privacy">
        {s.privacy}{' '}
        <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">
          {s.googlePrivacy}
        </a>
      </p>
    </div>
  </dialog>
</music-experience>

<script>
  import '@/scripts/music-experience';
</script>

<style>
  .music-shelf {
    --copper-light: #e8b993;
    --copper-line: #735843;
    --hardware-dark: #111113;
    position: fixed;
    z-index: 35;
    inset-inline-end: max(0.75rem, env(safe-area-inset-right, 0px));
    inset-block-end: max(0.75rem, env(safe-area-inset-bottom, 0px));
    display: block;
    max-width: calc(100vw - 1.5rem);
  }

  .music-dock {
    display: flex;
    max-width: 100%;
    align-items: end;
    gap: 0.35rem;
  }

  .shelf-inner {
    min-width: 0;
  }

  .music-card {
    display: grid;
    width: min(16.5rem, calc(100vw - 4.75rem));
    min-height: 54px;
    grid-template-columns: 2.65rem minmax(0, 1fr) auto;
    gap: 0.55rem;
    align-items: center;
    padding: 0.38rem 0.5rem;
    border: 1px solid #49413b;
    border-radius: 8px;
    background:
      radial-gradient(ellipse at top left, #47312361, transparent 68%),
      linear-gradient(138deg, #221e1c, #151516 73%);
    box-shadow:
      inset 0 1px #d8b59619,
      0 8px 20px #0004;
    text-decoration: none;
    transition:
      border-color var(--dur-ui) var(--ease-out),
      transform var(--dur-press) var(--ease-out);
  }

  .music-card:is(:hover, :focus-visible) {
    border-color: var(--copper-line);
  }

  .music-card:active {
    transform: scale(0.98);
  }

  .music-card:focus-visible,
  .music-panel :focus-visible {
    outline-color: var(--copper-light);
  }

  .card-copy,
  .panel-copy {
    display: grid;
    gap: 0.24rem;
  }

  .overline {
    margin: 0;
    color: var(--copper-light);
    font: 500 clamp(0.61rem, 1.5vw, 0.68rem)/1.3 var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .track,
  .panel-title {
    margin: 0;
    color: var(--fg);
    font-family: var(--font-display);
    font-weight: 720;
    letter-spacing: var(--track-heading);
  }

  .track {
    overflow: hidden;
    font-size: 1rem;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .artist {
    margin: 0;
    color: var(--fg-2);
    font-size: var(--text-caption);
    line-height: 1.3;
  }

  .card-copy {
    min-width: 0;
    gap: 0.1rem;
  }

  .card-copy .overline {
    font-size: 0.53rem;
  }

  .card-copy .artist {
    overflow: hidden;
    font-size: 0.65rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-action {
    display: grid;
    justify-items: center;
    gap: 0.28rem;
    padding-inline-start: 0.55rem;
    border-inline-start: 1px solid #51463e;
  }

  .play-icon {
    display: grid;
    width: 1.6rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid #685343;
    border-radius: 4px;
    background: linear-gradient(#3d3028, #211b17);
    box-shadow:
      inset 0 1px #eac29e2e,
      0 2px 5px #0005;
  }

  .play-icon::after {
    width: 0;
    height: 0;
    border-block: 0.31rem solid transparent;
    border-inline-start: 0.48rem solid var(--copper-light);
    transform: translateX(1px);
    transition: transform var(--dur-ui) var(--ease-out);
    content: '';
  }

  .music-card:is(:hover, :focus-visible) .play-icon::after {
    transform: translateX(3px);
  }

  .source {
    color: var(--fg-2);
    font-size: 0.55rem;
    line-height: 1;
  }

  .music-panel {
    position: fixed;
    inset: 0;
    width: min(44rem, calc(100% - 1.5rem));
    max-width: none;
    max-height: calc(100dvh - 1.5rem);
    margin: auto;
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid #6c5747;
    border-radius: 8px;
    background: var(--hardware-dark);
    color: var(--fg);
    box-shadow: 0 24px 80px #000c;
  }

  .music-panel[open] {
    animation: panel-arrive var(--dur-panel) var(--ease-out-expo) both;
  }

  .music-panel::backdrop {
    background: #08080abf;
  }

  .music-panel[open]::backdrop {
    animation: darken var(--dur-ui) var(--ease-out) both;
  }

  .panel-interior {
    padding: clamp(0.65rem, 3vw, 1.45rem);
    background:
      radial-gradient(ellipse at top left, #72503b45, transparent 64%),
      linear-gradient(#201b18, var(--hardware-dark) 40%);
  }

  .panel-header {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: clamp(3.7rem, 15vw, 7rem) minmax(0, 1fr) 44px;
    gap: clamp(0.55rem, 2.8vw, 1.3rem);
    align-items: center;
    margin-block-end: clamp(0.65rem, 3vw, 1.25rem);
  }

  .panel-title {
    font-size: clamp(1.65rem, 5vw, 3rem);
    line-height: 1;
  }

  .panel-close {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    align-self: start;
    padding: 0;
    border: 1px solid #64554a;
    border-radius: 5px;
    background: #251f1b;
    color: var(--fg-2);
    cursor: pointer;
    transition: background var(--dur-ui) var(--ease-out);
  }

  .panel-close:is(:hover, :focus-visible) {
    background: #3a2d24;
    color: var(--fg);
  }

  .panel-close span {
    display: grid;
    place-items: center;
  }

  .panel-close span::before,
  .panel-close span::after {
    grid-area: 1 / 1;
    width: 1.05rem;
    height: 1px;
    background: currentColor;
    transform: rotate(45deg);
    content: '';
  }

  .panel-close span::after {
    transform: rotate(-45deg);
  }

  .panel-header > :global(circuit-field) {
    z-index: -1;
  }

  .track-choice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
    color: var(--fg-2);
    font-size: var(--text-caption);
  }

  .track-choice select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 0.4rem 0.65rem;
    border: 1px solid #685343;
    border-radius: 4px;
    background: #211b18;
    color: var(--fg);
    font: inherit;
    color-scheme: dark;
  }

  .screen {
    position: relative;
    width: 100%;
    min-height: 200px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #080809;
    box-shadow: 0 0 0 1px #51463d;
  }

  .player-slot {
    position: absolute;
    inset: 0;
  }

  .screen :global(iframe) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .fallback-card {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(0.7rem, 3vw, 1.35rem);
    align-items: center;
    align-content: center;
    padding: clamp(0.75rem, 3vw, 1.4rem);
    overflow: auto;
    background:
      radial-gradient(ellipse at 22% 18%, #472e2166, transparent 62%),
      repeating-linear-gradient(0deg, transparent 0 3px, #ddba9706 4px 5px), #100e0e;
  }

  .fallback-card[hidden] {
    display: none;
  }

  .fallback-disc {
    width: clamp(3.8rem, 16vw, 7rem);
    aspect-ratio: 1;
    border: 1px solid #5a483c;
    border-radius: 50%;
    background:
      radial-gradient(circle, #1d1510 0 6%, #8d5c42 7% 24%, #1b1715 25% 29%, transparent 30%),
      repeating-radial-gradient(circle, transparent 0 3px, #c0a89d22 3px 4px),
      conic-gradient(
        from 40deg,
        #1b1817,
        #35302e 17%,
        #171414 38%,
        #111012 58%,
        #39312d 78%,
        #1b1817
      );
    box-shadow: 0 10px 20px #0008;
  }

  .fallback-copy {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    justify-items: start;
  }

  .fallback-title {
    margin: 0;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.8vw, 1.35rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .fallback-artist {
    margin: 0;
    color: var(--copper-light);
    font-size: var(--text-caption);
    line-height: 1.25;
  }

  .fallback-reason {
    margin: 0.15rem 0 0;
    max-width: 46ch;
    color: var(--fg-2);
    font-size: var(--text-caption);
    line-height: 1.42;
  }

  .fallback-action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    margin-top: 0.35rem;
    padding-inline: 0.9rem;
    border: 1px solid #a67856;
    border-radius: 5px;
    background: linear-gradient(180deg, #422b20, #2d1d16);
    color: #f4d3b4;
    font-size: var(--text-caption);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--dur-ui) var(--ease-out),
      background var(--dur-ui) var(--ease-out);
  }

  .fallback-action:is(:hover, :focus-visible) {
    border-color: var(--copper-light);
    background: linear-gradient(180deg, #523628, #37241b);
  }

  .panel-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    align-items: center;
    justify-content: space-between;
    margin-block-start: 0.55rem;
  }

  .player-status,
  .watch,
  .privacy {
    font-size: var(--text-caption);
  }

  .player-status {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    color: var(--fg-2);
  }

  .player-status::before {
    width: 0.4rem;
    flex: 0 0 auto;
    align-self: center;
    aspect-ratio: 1;
    border: 1px solid #bb977d;
    border-radius: 50%;
    content: '';
  }

  music-experience[data-state='playing'] .player-status::before {
    background: var(--copper-light);
    box-shadow: 0 0 8px #ffbf8e70;
  }

  /* Keep the aperture composed while loading before the iframe mounts. */
  .player-slot:empty {
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 7%, #342820, transparent 65%),
      repeating-linear-gradient(0deg, transparent 0 3px, #ddba9705 4px 5px), #100e0e;
  }

  .player-slot:empty::before {
    width: min(12rem, 58%);
    aspect-ratio: 1;
    border: 1px solid #504035;
    border-radius: 50%;
    background:
      radial-gradient(circle, #1d1510 0 3%, #795441 4% 19%, #1b1715 20% 24%, transparent 25%),
      repeating-radial-gradient(circle, transparent 0 3px, #c0a89d24 3px 4px),
      conic-gradient(
        from 40deg,
        #1b1817,
        #35302e 17%,
        #171414 38%,
        #111012 58%,
        #39312d 78%,
        #1b1817
      );
    box-shadow: 0 11px 22px #0008;
    content: '';
  }

  .watch {
    display: inline-flex;
    min-height: 44px;
    gap: 0.45rem;
    align-items: center;
    color: var(--copper-light);
  }

  .privacy {
    margin: 0;
    padding-block-start: 0.65rem;
    border-block-start: 1px solid #3d3530;
    color: var(--fg-2);
    line-height: 1.55;
  }

  @keyframes panel-arrive {
    from {
      transform: translateY(0.9rem) scale(0.985);
    }
  }

  @keyframes darken {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 440px) {
    .panel-meta {
      display: grid;
    }

    .fallback-card {
      grid-template-columns: 1fr;
    }

    .fallback-disc {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .music-card {
      grid-template-columns: 2.4rem minmax(0, 1fr) auto;
      gap: 0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .music-card,
    .play-icon::after,
    .panel-close,
    .fallback-action {
      transition: none;
    }

    .music-card:active {
      transform: none;
    }

    .music-panel[open],
    .music-panel[open]::backdrop {
      animation: none;
    }
  }
</style>
