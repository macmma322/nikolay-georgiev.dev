---
import { site } from '@/data/site';
import ContactFinale from '@/components/layout/ContactFinale.astro';
import Mark from '@/components/ui/Mark.astro';
import { useI18n } from '@/i18n';
import { common } from '@/i18n/ui/common';
import { contact } from '@/i18n/ui/contact';
import { openSource } from '@/i18n/ui/opensource';

const { l, t, href, path } = useI18n(Astro);
const s = t(common);
// The contact page is the finale; its footer keeps only the baseline.
const bare = path === '/contact';

const year = new Date().getFullYear();
---

<footer
  class:list={['site-footer', { bare }]}
  id={bare ? undefined : 'contact'}
  aria-labelledby={bare ? undefined : 'contact-title'}
>
  {!bare && <ContactFinale variant="footer" />}

  <div class="container baseline">
    <a class="signature" href={href('/')}>
      <Mark size={22} />
      <span class="label">
        NIKOLAY.RUNTIME <span class="ver">v3</span>
      </span>
      <span class="visually-hidden">{s.homeSuffix}</span>
    </a>
    <p>{l(contact.baseline)}</p>
    <a class="footer-link" href={href('/open-source')}>
      {l(openSource.title)}
    </a>
    <p class="copyright-line">
      <span>
        © {year} {site.name}
      </span>
      <button
        type="button"
        class="secret-portal"
        data-portal="/workspace/contracts"
        tabindex="-1"
        aria-hidden="true"
      >
        <span class="portal-dot"></span>
      </button>
    </p>
  </div>
</footer>

<script is:inline>
  (() => {
    const portal = document.querySelector('[data-portal]');
    if (portal) {
      portal.addEventListener('click', () => {
        window.location.href = portal.getAttribute('data-portal') || '/workspace/contracts';
      });
    }
    // Hidden shortcut: Ctrl+Shift+W or Cmd+Shift+W navigates directly to workspace
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'W' || e.key === 'w')) {
        e.preventDefault();
        window.location.href = '/workspace/contracts';
      }
    });
  })();
</script>

<style>
  .site-footer {
    margin-top: var(--space-3xl);
    border-top: 1px solid var(--line-soft);
    background: var(--ink-deep);
  }

  /* Under the contact page the baseline sits on the page itself: a short
     page would otherwise show the footer band ending above the fold. */
  .site-footer.bare {
    margin-top: var(--space-xl);
    background: none;
  }

  /* ---------- Baseline: the quiet signature ---------- */
  .baseline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    padding-block: var(--space-s) var(--space-l);
    border-top: 1px solid var(--line-soft);
    font-size: var(--text-caption);
    color: var(--fg-3);
  }

  .bare .baseline {
    border-top: 0;
  }

  .signature {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    text-decoration: none;
  }

  .signature .label {
    color: var(--fg-2);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .signature:is(:hover, :focus-visible) .label {
    color: var(--fg);
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg-2);
  }

  .footer-link:is(:hover, :focus-visible) {
    color: var(--fg);
  }

  .ver {
    text-transform: none;
    color: var(--fg-3);
  }

  .copyright-line {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .secret-portal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: none;
    background: transparent;
    border-radius: var(--radius-s);
    color: var(--fg-3);
    cursor: pointer;
    opacity: 0.35;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .portal-dot {
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    transition:
      background var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .secret-portal:is(:hover, :focus-visible) {
    opacity: 1;
    color: var(--fg);
    transform: scale(1.3);
  }

  .secret-portal:is(:hover, :focus-visible) .portal-dot {
    background: #6366f1;
    box-shadow:
      0 0 8px #6366f1,
      0 0 14px #6366f1;
  }
</style>
