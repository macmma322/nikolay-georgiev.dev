---
/**
 * The street that closes every page: an evening block still going up, people
 * walking past, and one figure standing still.
 *
 * Without JavaScript, or before the scene loads, this is the backdrop and the
 * standing figure: a finished picture. The crowd is an enhancement drawn on
 * two canvases, one behind him and one in front (scripts/street). It runs
 * only while it is on screen in a visible tab; with reduced motion it is one
 * still frame.
 *
 * The figure is three stacked layers of one illustration
 * (scripts/street-avatar.mjs): the body, the chest, which breathes, and the
 * head, which turns by under a degree and blinks.
 */
import { Image } from 'astro:assets';
import body from '@/assets/media/street/nikolay-body.webp';
import chest from '@/assets/media/street/nikolay-chest.webp';
import head from '@/assets/media/street/nikolay-head.webp';
import { nav, site } from '@/data/site';
import { useI18n } from '@/i18n';
import { common } from '@/i18n/ui/common';
import { street } from '@/i18n/ui/street';

const { l, t, href } = useI18n(Astro);
const s = t(street);
const c = t(common);

/** Passers-by who carry a project, in the order of the work index. */
const cast = [
  { slug: 'caelora', name: 'Caelora', accent: 'caelora' },
  { slug: 'uss-x-academy', name: 'USS X Academy', accent: 'ussx' },
  { slug: 'jarvis', name: 'J.A.R.V.I.S.', accent: 'jarvis' },
  { slug: 'zone-32-19', name: 'Zone 32-19', accent: 'zone' },
  { slug: 'kobait', name: 'KObait', accent: 'kobait' },
  { slug: 'malrynth', name: 'Malrynth', accent: 'malrynth' },
  { slug: 'stemini', name: 'Stemini', accent: 'stemini' },
] as const;

/*
 * The block, drawn once at build time from a fixed seed: a far skyline, a row
 * of buildings with their own windows and shopfronts, lamps, trees and the
 * pavement. Solid storeys are built; dashed ones are planned, the same
 * convention as the architecture diagrams. The view box is 2400 wide and
 * cropped from the centre on narrow screens.
 */
const VIEW_W = 2400;
const VIEW_H = 520;
const BASE = 364; // where the wall meets the pavement (lane 0 of the scene)
let seed = 3219;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) >>> 0;
  return seed / 4294967296;
};
const between = (lo: number, hi: number) => Math.round(lo + rand() * (hi - lo));
const chance = (p: number) => rand() < p;
// The hoarding he stands in front of: no shopfront is drawn behind it.
const PLOT = { x: 1000, w: 400 };

const far: { x: number; w: number; h: number; mast: boolean }[] = [];
for (let x = -30; x < VIEW_W;) {
  const w = between(70, 190);
  far.push({ x, w, h: between(170, 340), mast: chance(0.25) });
  x += w + between(-8, 14);
}

type Pane = 'dark' | 'warm' | 'dim' | 'cool';
interface Block {
  x: number;
  w: number;
  top: number;
  tone: number;
  floor: number;
  planned: number;
  panes: { x: number; y: number; w: number; h: number; kind: Pane }[];
  sills: number[];
  shop: { awning: number; door: number; lit: boolean } | null;
  roof: { x: number; w: number; h: number }[];
  scaffold: boolean;
}
const blocks: Block[] = [];
for (let x = -40; x < VIEW_W;) {
  const w = between(190, 340);
  const floor = between(36, 44);
  const built = between(3, 6);
  const onPlot = x < PLOT.x + PLOT.w && x + w > PLOT.x;
  const planned = chance(onPlot ? 1 : 0.4) ? between(1, 3) : 0;
  const top = BASE - 50 - built * floor;
  const pw = between(13, 18);
  const ph = between(18, 25);
  const bay = pw + between(16, 24);
  const balcony = chance(0.4);
  const panes: Block['panes'] = [];
  const sills: number[] = [];
  for (let level = 0; level < built; level += 1) {
    const y = top + level * floor + (floor - ph) / 2;
    if (balcony) sills.push(y + ph + 4);
    for (let px = x + 20; px < x + w - 20 - pw; px += bay) {
      if (chance(0.08)) continue;
      const roll = rand();
      const kind: Pane = roll < 0.66 ? 'dark' : roll < 0.82 ? 'warm' : roll < 0.94 ? 'dim' : 'cool';
      panes.push({ x: px, y, w: pw, h: ph, kind });
    }
  }
  const roof: Block['roof'] = [];
  if (!planned) {
    for (let i = 0, n = between(0, 3); i < n; i += 1) {
      roof.push({ x: x + between(14, w - 60), w: between(18, 44), h: between(8, 22) });
    }
  }
  blocks.push({
    x,
    w,
    top,
    tone: between(0, 2),
    floor,
    planned,
    panes,
    sills,
    shop: onPlot
      ? null
      : { awning: between(0, 3), door: x + between(24, w - 60), lit: chance(0.7) },
    roof,
    scaffold: planned > 0 && !onPlot && chance(0.5),
  });
  x += w + between(0, 22);
}
// Batch all window panes by tone into four single <path> strings to cut ~150+ SVG DOM nodes.
const panePaths: Record<Pane, string[]> = { dark: [], warm: [], dim: [], cool: [] };
for (const b of blocks) {
  for (const p of b.panes) {
    panePaths[p.kind].push(`M${p.x} ${p.y}h${p.w}v${p.h}h${-p.w}z`);
  }
}
const paneBatches = (['dark', 'dim', 'warm', 'cool'] as const)
  .map((kind) => ({ kind, d: panePaths[kind].join('') }))
  .filter((batch) => batch.d.length > 0);

// One tower crane, over the block behind the hoarding.
const plot =
  blocks.find((b) => b.x < PLOT.x + PLOT.w / 2 && b.x + b.w > PLOT.x + PLOT.w / 2) ?? blocks[3]!;
const crane = { x: plot.x + plot.w * 0.64, top: 30 };
const lamps = [150, 560, 1620, 2040];
const trees = [330, 820, 1500, 1880, 2280];
const sizes = '(min-width: 64rem) 126px, 84px';
const widths = [112, 168, 252, 336, 528];
---

<section
  class="street"
  aria-labelledby="street-title"
  data-street
  data-scene="street"
  data-label-street={s.label}
  data-label-cafe={s.cafeLabel}
  data-cast-street={s.castLabel}
  data-cast-cafe={s.cafeCastLabel}
  data-status-idle={s.cafeStatus.idle}
  data-status-glance={s.cafeStatus.glance}
  data-status-coffee={s.cafeStatus.coffee}
  data-status-phone={s.cafeStatus.phone}
  data-status-laptop={s.cafeStatus.laptop}
  data-me-street={s.me}
  data-me-cafe={s.meCafe}
  data-desc-street={s.description}
  data-desc-cafe={s.cafeDescription}
>
  <div class="container street-head reveal">
    <div class="street-say">
      <p class="label" data-scene-eyebrow>
        {s.label}
      </p>
      <h2 id="street-title" class="street-title">
        {s.title.lead} <em>{s.title.em}</em>
      </h2>
      <p class="street-support">{s.support}</p>
    </div>
    <nav class="street-nav" aria-label={s.navLabel}>
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a href={href(item.href)}>{l(item.label)}</a>
          </li>
        ))}
        <li>
          <a href={href(site.cv.page)}>{c.cv}</a>
        </li>
      </ul>
      <a class="to-top" href="#top" data-to-top>
        {s.toTop}
        <span class="glyph" aria-hidden="true">
          ↑
        </span>
      </a>
    </nav>
  </div>

  <div class="stage" data-stage data-state="static">
    <slot name="circuit" />
    <svg
      class="block"
      viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
      preserveAspectRatio="xMidYMax slice"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <radialGradient id="street-glow">
          <stop offset="0" stop-color="oklch(0.9 0.09 82)" stop-opacity="0.5"></stop>
          <stop offset="1" stop-color="oklch(0.9 0.09 82)" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="street-pool">
          <stop offset="0" stop-color="oklch(0.84 0.08 80)" stop-opacity="0.3"></stop>
          <stop offset="1" stop-color="oklch(0.84 0.08 80)" stop-opacity="0"></stop>
        </radialGradient>
        <linearGradient id="street-ground" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="oklch(0.33 0.014 262)"></stop>
          <stop offset="0.45" stop-color="oklch(0.25 0.012 262)"></stop>
          <stop offset="1" stop-color="oklch(0.15 0.008 262)"></stop>
        </linearGradient>
        <linearGradient id="street-shop" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="oklch(0.8 0.1 80)"></stop>
          <stop offset="1" stop-color="oklch(0.62 0.1 66)"></stop>
        </linearGradient>
      </defs>

      <g class="far">
        {far.map((f) => (
          <path
            d={`M${f.x} ${BASE}V${BASE - f.h}h${f.w}V${BASE}${f.mast ? `M${f.x + f.w * 0.4} ${BASE - f.h}v-26` : ''}`}
          />
        ))}
      </g>

      {blocks.map((b) => (
        <g class:list={['building', `tone-${b.tone}`]}>
          <rect class="wall" x={b.x} y={b.top} width={b.w} height={BASE - b.top} />
          <rect class="cornice" x={b.x - 3} y={b.top - 5} width={b.w + 6} height="6" />
          {b.roof.map((r) => (
            <rect class="roof" x={r.x} y={b.top - 5 - r.h} width={r.w} height={r.h} />
          ))}
          {b.planned > 0 && (
            <path
              class="planned"
              d={`M${b.x} ${b.top - 5}v${-b.planned * b.floor}h${b.w}v${b.planned * b.floor}${Array.from(
                { length: b.planned - 1 },
                (_, i) => `M${b.x} ${b.top - 5 - (i + 1) * b.floor}h${b.w}`,
              ).join('')}`}
            />
          )}
        </g>
      ))}

      {paneBatches.map(({ kind, d }) => (
        <path class:list={['pane', kind]} d={d} />
      ))}

      {blocks.map((b) => (
        <g class:list={['building', `tone-${b.tone}`]}>
          {b.sills.length > 0 && (
            <path class="sill" d={b.sills.map((y) => `M${b.x + 12} ${y}h${b.w - 24}`).join('')} />
          )}
          {b.shop && (
            <g class:list={['shop', { lit: b.shop.lit }]}>
              <rect class="glass" x={b.x + 14} y={BASE - 40} width={b.w - 28} height="34" />
              <path
                class="mullion"
                d={`M${b.x + 14 + (b.w - 28) / 3} ${BASE - 40}v34M${b.x + 14 + ((b.w - 28) * 2) / 3} ${BASE - 40}v34`}
              />
              <rect class="door" x={b.shop.door} y={BASE - 40} width="20" height="40" />
              <path
                class:list={['awning', `awning-${b.shop.awning}`]}
                d={`M${b.x + 8} ${BASE - 50}h${b.w - 16}l8 12h${-b.w}z`}
              />
              {b.shop.lit && (
                <ellipse class="spill" cx={b.x + b.w / 2} cy={BASE + 22} rx={b.w * 0.52} ry="30" />
              )}
            </g>
          )}
          {b.scaffold && (
            <path
              class="scaffold"
              d={`${Array.from({ length: Math.floor(b.w / 38) + 1 }, (_, i) => `M${b.x + i * 38} ${BASE - 50}V${b.top - 5 - b.floor}`).join('')}${Array.from(
                { length: Math.floor((BASE - 50 - b.top) / b.floor) + 2 },
                (_, i) => `M${b.x} ${BASE - 50 - i * b.floor}h${b.w}`,
              ).join('')}`}
            />
          )}
        </g>
      ))}

      <g class="crane">
        <path
          d={`M${crane.x} ${plot.top}V${crane.top}M${crane.x - 150} ${crane.top + 16}H${crane.x + 300}M${crane.x} ${crane.top}L${crane.x + 300} ${crane.top + 16}M${crane.x} ${crane.top}L${crane.x - 150} ${crane.top + 16}`}
        />
        <path class="cable" d={`M${crane.x + 214} ${crane.top + 16}v84`} />
        <rect x={crane.x + 207} y={crane.top + 100} width="14" height="10" />
        <rect x={crane.x - 142} y={crane.top + 18} width="34" height="18" />
      </g>

      {/* The pavement, with its joints running to one vanishing point. */}
      <rect class="ground" x="0" y={BASE} width={VIEW_W} height={VIEW_H - BASE} />
      <path
        class="joint"
        d={`M0 ${BASE + 34}H${VIEW_W}M0 ${BASE + 76}H${VIEW_W}M0 ${BASE + 126}H${VIEW_W}${Array.from(
          { length: 41 },
          (_, i) => `M${i * 60} ${BASE + 9}L${1200 + (i * 60 - 1200) * 1.55} ${VIEW_H}`,
        ).join('')}`}
      />
      <rect class="kerb" x="0" y={BASE} width={VIEW_W} height="9" />

      {trees.map((x, i) => (
        <g class="tree">
          <path
            class="trunk"
            d={`M${x} ${BASE + 4}v-74M${x} ${BASE - 44}l-12 -18M${x} ${BASE - 50}l14 -16`}
          />
          <circle cx={x - 16} cy={BASE - 96 - (i % 2) * 8} r="30" />
          <circle cx={x + 18} cy={BASE - 104} r="34" />
          <circle cx={x + 2} cy={BASE - 132 - (i % 3) * 6} r="30" />
          <ellipse class="canopy-rim" cx={x + 4} cy={BASE - 138 - (i % 3) * 6} rx="24" ry="10" />
        </g>
      ))}

      {/* Street furniture: architectural benches and bike stands along the kerb. */}
      <g class="furniture">
        <path
          class="bench"
          d={`M430 ${BASE - 12}h56M426 ${BASE - 5}h64M436 ${BASE - 12}v16M478 ${BASE - 12}v16M1730 ${BASE - 12}h56M1726 ${BASE - 5}h64M1736 ${BASE - 12}v16M1778 ${BASE - 12}v16`}
        />
        <path
          class="bollard"
          d={`M710 ${BASE + 3}v-18M742 ${BASE + 3}v-18M1560 ${BASE + 3}v-18M1592 ${BASE + 3}v-18`}
        />
      </g>

      {lamps.map((x) => (
        <g class="lamp">
          <ellipse class="pool" cx={x + 14} cy={BASE + 30} rx="170" ry="40" />
          <circle class="halo" cx={x + 22} cy={BASE - 150} r="64" />
          <path d={`M${x} ${BASE + 5}V${BASE - 152}h18`} />
          <rect x={x + 12} y={BASE - 153} width="20" height="6" />
        </g>
      ))}

      {/* The site hoarding: the lit board he stands in front of. */}
      <g class="hoarding">
        <ellipse class="pool" cx="1200" cy={BASE + 34} rx="330" ry="52" />
        <path class="cone" d="M1088 196 L1000 364 H1210 Z" />
        <path class="cone" d="M1312 196 L1190 364 H1400 Z" />
        <rect class="board" x={PLOT.x} y="212" width={PLOT.w} height="152" />
        <path class="seam" d="M1100 212v152M1200 212v152M1300 212v152M1000 230h400M1000 352h400" />
        <path class="post" d="M1088 212v-22h-16M1312 212v-22h16" />
        <rect class="head" x="1062" y="186" width="16" height="6" />
        <rect class="head" x="1322" y="186" width="16" height="6" />
        <text class="stencil" x="1016" y="254">
          {s.sign}
        </text>
      </g>
    </svg>

    {/* Scenario B: Evening Café architectural interior & street-view windows. */}
    <svg
      class="cafe-room"
      viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
      preserveAspectRatio="xMidYMax slice"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient id="cafe-wall-bg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="oklch(0.14 0.012 260)"></stop>
          <stop offset="0.58" stop-color="oklch(0.18 0.016 54)"></stop>
          <stop offset="1" stop-color="oklch(0.14 0.014 48)"></stop>
        </linearGradient>
        <radialGradient id="cafe-pendant-glow">
          <stop offset="0" stop-color="oklch(0.92 0.11 82)" stop-opacity="0.72"></stop>
          <stop offset="0.38" stop-color="oklch(0.8 0.1 72)" stop-opacity="0.28"></stop>
          <stop offset="0.75" stop-color="oklch(0.66 0.08 64)" stop-opacity="0.08"></stop>
          <stop offset="1" stop-color="oklch(0.66 0.08 64)" stop-opacity="0"></stop>
        </radialGradient>
        <linearGradient id="cafe-light-cone" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="oklch(0.9 0.1 82)" stop-opacity="0.24"></stop>
          <stop offset="0.52" stop-color="oklch(0.8 0.09 74)" stop-opacity="0.1"></stop>
          <stop offset="1" stop-color="oklch(0.72 0.07 68)" stop-opacity="0.02"></stop>
        </linearGradient>
        <radialGradient id="cafe-alcove-wash" cx="50%" cy="46%" r="55%">
          <stop offset="0" stop-color="oklch(0.46 0.075 66)" stop-opacity="0.45"></stop>
          <stop offset="0.58" stop-color="oklch(0.28 0.04 58)" stop-opacity="0.2"></stop>
          <stop offset="1" stop-color="oklch(0.16 0.015 50)" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="cafe-floor-pool">
          <stop offset="0" stop-color="oklch(0.84 0.1 76)" stop-opacity="0.38"></stop>
          <stop offset="0.48" stop-color="oklch(0.7 0.085 68)" stop-opacity="0.16"></stop>
          <stop offset="1" stop-color="oklch(0.68 0.07 66)" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="cafe-bokeh-amber">
          <stop offset="0" stop-color="oklch(0.88 0.12 78)" stop-opacity="0.62"></stop>
          <stop offset="0.45" stop-color="oklch(0.76 0.1 70)" stop-opacity="0.24"></stop>
          <stop offset="1" stop-color="oklch(0.72 0.09 68)" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="cafe-bokeh-cool">
          <stop offset="0" stop-color="oklch(0.74 0.08 232)" stop-opacity="0.45"></stop>
          <stop offset="0.5" stop-color="oklch(0.62 0.06 240)" stop-opacity="0.14"></stop>
          <stop offset="1" stop-color="oklch(0.55 0.05 245)" stop-opacity="0"></stop>
        </radialGradient>
        <linearGradient id="cafe-floor" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="oklch(0.25 0.022 56)"></stop>
          <stop offset="0.32" stop-color="oklch(0.2 0.018 52)"></stop>
          <stop offset="0.72" stop-color="oklch(0.15 0.012 252)"></stop>
          <stop offset="1" stop-color="oklch(0.11 0.008 258)"></stop>
        </linearGradient>
        <linearGradient id="cafe-walnut" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="oklch(0.35 0.046 58)"></stop>
          <stop offset="0.48" stop-color="oklch(0.26 0.036 54)"></stop>
          <stop offset="1" stop-color="oklch(0.17 0.022 48)"></stop>
        </linearGradient>
        <linearGradient id="cafe-copper" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="oklch(0.72 0.105 70)"></stop>
          <stop offset="0.45" stop-color="oklch(0.56 0.095 60)"></stop>
          <stop offset="1" stop-color="oklch(0.34 0.055 50)"></stop>
        </linearGradient>
        <linearGradient id="cafe-steel" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="oklch(0.38 0.018 258)"></stop>
          <stop offset="0.5" stop-color="oklch(0.24 0.014 258)"></stop>
          <stop offset="1" stop-color="oklch(0.16 0.012 258)"></stop>
        </linearGradient>
        <linearGradient id="cafe-shelf-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="oklch(0.84 0.1 78)" stop-opacity="0.22"></stop>
          <stop offset="0.55" stop-color="oklch(0.72 0.08 70)" stop-opacity="0.06"></stop>
          <stop offset="1" stop-color="oklch(0.65 0.06 66)" stop-opacity="0"></stop>
        </linearGradient>
        <linearGradient id="cafe-window" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="oklch(0.13 0.018 262 / 0.8)"></stop>
          <stop offset="0.56" stop-color="oklch(0.19 0.028 274 / 0.62)"></stop>
          <stop offset="0.86" stop-color="oklch(0.26 0.04 54 / 0.48)"></stop>
          <stop offset="1" stop-color="oklch(0.32 0.055 68 / 0.44)"></stop>
        </linearGradient>
      </defs>

      {/* Interior textured charcoal plaster & wainscot back wall */}
      <rect x="0" y="0" width={VIEW_W} height={BASE} fill="url(#cafe-wall-bg)" />
      {/* Subtle architectural brick/plaster masonry courses */}
      <path
        d={`M0 84H${VIEW_W}M0 132H${VIEW_W}M0 180H${VIEW_W}M0 228H${VIEW_W}M0 276H${VIEW_W}M0 324H${VIEW_W}`}
        stroke="oklch(0.24 0.018 58 / 0.22)"
        stroke-width="1"
      />
      {/* Ceiling beam & brushed-brass crown molding */}
      <rect x="0" y="0" width={VIEW_W} height="34" fill="oklch(0.11 0.01 258)" />
      <rect x="0" y="34" width={VIEW_W} height="4" fill="url(#cafe-copper)" opacity="0.65" />
      <rect x="0" y="38" width={VIEW_W} height="10" fill="oklch(0.08 0.008 258 / 0.42)" />
      {/* Lower wainscot dado rail */}
      <rect x="0" y={BASE - 26} width={VIEW_W} height="26" fill="oklch(0.14 0.014 48)" />
      <path d={`M0 ${BASE - 26}H${VIEW_W}`} stroke="oklch(0.36 0.042 60 / 0.7)" stroke-width="2" />

      {/* Left picture window bay looking out onto the evening street (x: 110..930, y: 64..340) */}
      <g class="cafe-window-bay">
        {/* Deep architectural reveal frame */}
        <rect x="98" y="52" width="844" height="296" rx="2" fill="oklch(0.09 0.01 258)" />
        <rect
          x="104"
          y="58"
          width="832"
          height="286"
          fill="oklch(0.13 0.012 258)"
          stroke="oklch(0.34 0.03 62 / 0.5)"
          stroke-width="1.5"
        />
