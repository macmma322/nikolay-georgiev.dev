---
/**
 * The street that closes every page: an evening block still going up, people
 * walking past, and one figure standing still.
 *
 * Without JavaScript, or before the scene loads, this is the backdrop and the
 * standing figure: a finished picture. The crowd is an enhancement drawn on
 * two canvases, one behind him and one in front (scripts/street). It runs
 * only while it is on screen in a visible tab; with reduced motion it is one
 * still frame.
 *
 * The figure is three stacked layers of one illustration
 * (scripts/street-avatar.mjs): the body, the chest, which breathes, and the
 * head, which turns by under a degree and blinks.
 */
import { getImage, Image } from 'astro:assets';
import body from '@/assets/media/street/nikolay-body.webp';
import chest from '@/assets/media/street/nikolay-chest.webp';
import head from '@/assets/media/street/nikolay-head.webp';
import leavesLeft from '@/assets/media/street/street-leaves-left.webp';
import leavesRight from '@/assets/media/street/street-leaves-right.webp';
import plateTall from '@/assets/media/street/street-plate-portrait.webp';
import plateWide from '@/assets/media/street/street-plate.webp';
import { nav, site } from '@/data/site';
import { useI18n } from '@/i18n';
import { common } from '@/i18n/ui/common';
import { street } from '@/i18n/ui/street';

const { l, t, href } = useI18n(Astro);
const s = t(street);
const c = t(common);

/** Passers-by who carry a project, in the order of the work index. */
const cast = [
  {
    slug: 'caelora',
    name: 'Caelora',
    accent: 'caelora',
    icon: 'M1.5 11.5 5 5.5 7.5 9 9.5 6.5 12.5 11.5z',
  },
  {
    slug: 'uss-x-academy',
    name: 'USS X Academy',
    accent: 'ussx',
    icon: 'M7 2.5 1.5 5.5 7 8.5 12.5 5.5z M3.5 7.2v2.8c0 .9 1.6 1.6 3.5 1.6s3.5-.7 3.5-1.6V7.2',
  },
  {
    slug: 'jarvis',
    name: 'J.A.R.V.I.S.',
    accent: 'jarvis',
    icon: 'M7 2 12 4.8v4.4L7 12 2 9.2V4.8z M7 7l5-2.2 M7 7L2 4.8 M7 7v5',
  },
  {
    slug: 'zone-32-19',
    name: 'Zone 32-19',
    accent: 'zone',
    icon: 'M2 4.5 7 2 12 4.5v5L7 12 2 9.5z M2 4.5 7 7l5-2.5 M7 7v5',
  },
  {
    slug: 'kobait',
    name: 'KObait',
    accent: 'kobait',
    icon: 'M8.5 2.5v5.8a2.4 2.4 0 0 1-4.8 0v-.6l1.3 1.1',
  },
  {
    slug: 'malrynth',
    name: 'Malrynth',
    accent: 'malrynth',
    icon: 'M4.8 4 1.8 7l3 3 M9.2 4l3 3-3 3 M7.8 3.2 6.2 10.8',
  },
  {
    slug: 'stemini',
    name: 'Stemini',
    accent: 'stemini',
    icon: 'M7 2.2 12 4.8 7 7.4 2 4.8z M2.5 7.6 7 10.1l4.5-2.5 M2.5 10 7 12.4l4.5-2.4',
  },
] as const;

/*
 * The street is one photograph (src/assets/media/street/street-plate.webp),
 * served in two crops: the whole frame, and its middle 45% for a phone held
 * upright. Everything that stands on it is placed in fractions of that frame
 * (`.plate`), so the wall, the pavement and the people keep one perspective at
 * any size. scripts/street/scene.ts reads the same box for its lanes.
 */
const WIDE = [1280, 1920, 2560, 3200];
const TALL = [640, 960, 1280];
const PHONE = '(max-width: 40rem) and (orientation: portrait)';
const srcset = async (src: ImageMetadata, sizes: number[], format: 'avif' | 'webp') =>
  (
    await Promise.all(
      sizes.map(async (width) => {
        const image = await getImage({
          src,
          width,
          format,
          quality: format === 'avif' ? 50 : 68,
        });
        return `${image.src} ${width}w`;
      }),
    )
  ).join(', ');
const plate = {
  tallAvif: await srcset(plateTall, TALL, 'avif'),
  tallWebp: await srcset(plateTall, TALL, 'webp'),
  wideAvif: await srcset(plateWide, WIDE, 'avif'),
  wideWebp: await srcset(plateWide, WIDE, 'webp'),
  fallback: (await getImage({ src: plateWide, width: 1920, format: 'webp', quality: 68 })).src,
};
const leafSrc = async (src: ImageMetadata) =>
  (await getImage({ src, width: 640, format: 'webp', quality: 70 })).src;
const leaves = { left: await leafSrc(leavesLeft), right: await leafSrc(leavesRight) };

// The figure is about a tenth of the frame wide; the frame is the viewport
// wide, or 1.25 viewports on an upright phone.
const sizes = '(max-width: 40rem) 22vw, 10vw';
const widths = [112, 168, 252, 336, 528];
---

<section class="street" aria-labelledby="street-title" data-street>
  <div class="container street-head reveal">
    <div class="street-say">
      <p class="label">{s.label}</p>
      <h2 id="street-title" class="street-title">
        {s.title.lead} <em>{s.title.em}</em>
      </h2>
      <p class="street-support">{s.support}</p>
    </div>
    <nav class="street-nav" aria-label={s.navLabel}>
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a href={href(item.href)}>{l(item.label)}</a>
          </li>
        ))}
        <li>
          <a href={href(site.cv.page)}>{c.cv}</a>
        </li>
      </ul>
      <a class="to-top" href="#top" data-to-top>
        {s.toTop}
        <span class="glyph" aria-hidden="true">
          ↑
        </span>
      </a>
    </nav>
  </div>

  <div class="stage" data-stage data-state="static">
    <slot name="circuit" />
    <div class="plate" data-plate>
      <picture>
        <source media={PHONE} type="image/avif" srcset={plate.tallAvif} sizes="100vw" />
        <source media={PHONE} type="image/webp" srcset={plate.tallWebp} sizes="100vw" />
        <source type="image/avif" srcset={plate.wideAvif} sizes="100vw" />
        <img
          class="stage-backdrop"
          src={plate.fallback}
          srcset={plate.wideWebp}
          sizes="100vw"
          alt=""
          width="3840"
          height="2160"
          loading="lazy"
          decoding="async"
        />
      </picture>

      {/* What moves in a street nobody is walking through. */}
      <div class="life" aria-hidden="true">
        <img class="leaves left" src={leaves.left} alt="" loading="lazy" decoding="async" />
        <img class="leaves right" src={leaves.right} alt="" loading="lazy" decoding="async" />
        <i class="beacon"></i>
        <i class="signal"></i>
        <i class="window one"></i>
        <i class="window two"></i>
        <i class="glow one"></i>
        <i class="glow two"></i>
        <i class="glow three"></i>
      </div>
      <p class="stencil" aria-hidden="true">
        {s.sign}
      </p>

      <button class="me" type="button" data-me aria-label={s.me}>
        <span class="me-mirror" aria-hidden="true">
          <Image
            src={body}
            alt=""
            widths={widths}
            sizes={sizes}
            quality={88}
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="me-figure">
          <Image
            src={body}
            alt=""
            widths={widths}
            sizes={sizes}
            quality={88}
            loading="lazy"
            decoding="async"
          />
          <span class="me-chest">
            <Image
              src={chest}
              alt=""
              widths={widths}
              sizes={sizes}
              quality={88}
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="me-rise">
            <span class="me-head">
              <Image
                src={head}
                alt=""
                widths={widths}
                sizes={sizes}
                quality={88}
                loading="lazy"
                decoding="async"
              />
              <svg class="me-lids" viewBox="0 0 528 1520" aria-hidden="true" focusable="false">
                <path d="M240 118q14-11 29-1q-14 9-29 1z"></path>
                <path d="M296 111q12-11 26-2q-12 9-26 2z"></path>
              </svg>
            </span>
          </span>
        </span>
      </button>
      <p class="me-tag label" aria-hidden="true">
        <span class="me-pin"></span>
        {site.name}
      </p>
    </div>

    <canvas class="layer back" data-layer="back" aria-hidden="true"></canvas>
    <canvas class="layer front" data-layer="front" aria-hidden="true"></canvas>
    <p class="visually-hidden">{s.description}</p>
  </div>

  <div class="container street-foot">
    <p class="label cast-eyebrow">{s.castLabel}</p>
    <ul class="cast" role="list">
      {cast.map((member) => (
        <li>
          <a
            href={href(`/work/${member.slug}`)}
            data-cast={member.slug}
            data-accent={member.accent}
          >
            <svg
              class="cast-ico"
              viewBox="0 0 14 14"
              width="16"
              height="16"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d={member.icon}
                fill="none"
                stroke="currentColor"
                stroke-width="1.15"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="role">{s.cast[member.slug]}</span>
            <span class="of">{member.name}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="tally label" aria-hidden="true" title={s.passedNote}>
      {s.passed} <span data-street-count>000</span>
    </p>
  </div>
</section>

<script>
  // The scene is a separate chunk, fetched only when the footer is near.
  const root = document.querySelector<HTMLElement>('[data-street]');
  const stage = root?.querySelector<HTMLElement>('[data-stage]');
  const back = root?.querySelector<HTMLCanvasElement>('[data-layer="back"]');
  const front = root?.querySelector<HTMLCanvasElement>('[data-layer="front"]');

  if (
    root &&
    stage &&
    back &&
    front &&
    'IntersectionObserver' in window &&
    'ResizeObserver' in window
  ) {
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        near.disconnect();
        let testing = false;
        let seed: number | undefined;
        try {
          // The e2e suite asks for a fixed street and a handle to step it.
          const flag = localStorage.getItem('ng-street:test');
          testing = flag !== null;
          if (flag && /^\d+$/.test(flag)) seed = Number(flag);
        } catch {
          // Storage is blocked: the street runs as for anyone else.
        }
        import('@/scripts/street/scene')
          .then(({ createStreet }) => {
            const street = createStreet({
              stage,
              back,
              front,
              avatar: root.querySelector<HTMLElement>('[data-me]'),
              counter: root.querySelector<HTMLElement>('[data-street-count]'),
              cast: Array.from(root.querySelectorAll<HTMLElement>('[data-cast]')),
              reduce: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
              ...(seed === undefined ? {} : { seed }),
            });
            root.dataset['ready'] = '';
            if (testing) (window as unknown as { __street?: typeof street }).__street = street;
          })
          .catch(() => {
            // The picture without the crowd is still the footer.
          });
      },
      { rootMargin: '600px 0px' },
    );
    near.observe(stage);
  }
</script>

<style>
  :global(html[data-avatar-away]) :is(.me, .me-tag) {
    visibility: hidden;
  }
  :global(html[data-avatar-still]) .me :is(.me-figure, .me-rise, .me-head, .me-chest, .me-lids) {
    animation: none !important;
    transition: none !important;
    rotate: none !important;
    translate: none !important;
  }
  :global(html[data-avatar-still]) .me .me-lids {
    visibility: hidden;
  }
  .street {
    position: relative;
    border-top: 1px solid var(--line-soft);
  }

  /* ---------- What the street says, and the way back ---------- */
  .street-head {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-xl) var(--space-l);
  }

  .street-say {
    display: grid;
    gap: var(--space-s);
  }

  .street-title {
    font-family: var(--ff-display);
    font-size: var(--step-3);
    font-stretch: var(--wide-2);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-heading);
    line-height: 1.06;
    text-wrap: balance;
    color: var(--fg-2);
  }

  .street-title em {
    font-style: normal;
    color: var(--fg);
  }

  .street-support {
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--fg-3);
    max-width: 34ch;
  }

  .street-nav {
    display: grid;
    gap: var(--space-s);
    align-content: end;
  }

  .street-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.6rem;
  }

  .street-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    font-family: var(--ff-display);
    font-stretch: var(--wide-1);
    font-weight: var(--w-medium);
    text-decoration: none;
    color: var(--fg-2);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .street-nav a:is(:hover, :focus-visible) {
    color: var(--fg);
  }

  .street-nav .to-top {
    justify-self: start;
    color: var(--fg);
  }

  .to-top .glyph {
    display: inline-block;
    transition: translate var(--dur-ui) var(--ease-out);
  }

  .to-top:focus-visible .glyph {
    translate: 0 -3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .to-top:hover .glyph {
      translate: 0 -3px;
    }
  }

  /*
   * From a laptop up the street is the whole screen: the words sit in its dark
   * upper corners and the people in the crowd along its foot, all three stacked
   * in one grid cell so the photograph alone sets the height.
   */
  @media (min-width: 60rem) {
    .street {
      display: grid;
    }
    .street > :global(*) {
      grid-area: 1 / 1;
    }
    .street-head {
      z-index: 2;
      align-self: start;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      column-gap: var(--space-xl);
      padding-block: clamp(1.5rem, 4.5vh, 3.25rem) 0;
      pointer-events: none;
      text-shadow: 0 1px 14px oklch(0.06 0.01 262 / 0.9);
    }
    .street-head :is(a, h2, p) {
      pointer-events: auto;
    }
    .street-title {
      font-size: clamp(1.55rem, 0.95rem + 1.35vw, 2.5rem);
      max-width: 17ch;
    }
    .street-support {
      color: var(--fg-2);
      max-width: 30ch;
    }
    .street-nav {
      justify-items: end;
      align-content: start;
    }
    .street-nav ul {
      justify-content: end;
      gap: 0 1.25rem;
    }
    .street-nav a {
      font-size: var(--text-caption);
    }
    .street-nav .to-top {
      justify-self: end;
    }
  }

  /* ---------- The stage ---------- */
  /*
   * One evening photograph, one light: warm from the lamps on the wall, cool
   * everywhere else. `.plate` is the photograph's own box. It always covers the
   * stage, cropped evenly at the sides and mostly from the sky, and everything
   * that belongs to the street is placed in fractions of it, so nothing drifts
   * off the pavement when the screen changes shape.
   */
  .stage {
    --plate-ar: 1.7778;
    /* The part of the full frame this crop shows, for things placed by --x. */
    --crop-x: 0;
    --crop-w: 1;
    --stage-h: clamp(22rem, min(100svh - var(--header-h, 4rem), 56.25vw), 76rem);
    position: relative;
    height: var(--stage-h);
    overflow: hidden;
    isolation: isolate;
    container-type: size;
    contain: layout paint style;
    border-block: 1px solid var(--line-soft);
    background: linear-gradient(to bottom, oklch(0.13 0.02 262), oklch(0.11 0.012 262));
  }

  @media (max-width: 40rem) and (orientation: portrait) {
    .stage {
      --plate-ar: 0.8;
      --crop-x: 0.275;
      --crop-w: 0.45;
      --stage-h: clamp(22rem, 122vw, 78svh);
    }
  }

  /* The circuitry belongs to the drawn pages, not to a photograph. */
  .stage > :global(circuit-field) {
    display: none;
  }

  .plate {
    --ph: max(100cqh, 100cqw / var(--plate-ar));
    --pw: calc(var(--ph) * var(--plate-ar));
    position: absolute;
    left: calc((100cqw - var(--pw)) / 2);
    top: calc((100cqh - var(--ph)) * 0.72);
    width: var(--pw);
    height: var(--ph);
  }

  .stage-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Where the words sit, the photograph steps back: the sky above, the
     nearest pavement below. Two fixed gradients, nothing blended or blurred
     over the moving canvases. */
  .stage::after {
    content: '';
    position: absolute;
    z-index: 5;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, oklch(0.07 0.012 262 / 0.62), transparent 30%),
      linear-gradient(
        to top,
        oklch(0.06 0.01 262 / 0.86),
        oklch(0.06 0.01 262 / 0.3) 17%,
        transparent 34%
      );
    box-shadow: inset 0 0 10rem 0 oklch(0.06 0.01 262 / 0.5);
  }

  /* ---------- What moves when nobody is walking ---------- */
  .life {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .life > :global(*) {
    position: absolute;
    left: calc((var(--x) - var(--crop-x)) / var(--crop-w) * 100%);
    top: calc(var(--y) * 100%);
  }

  /* The canopies: the same pixels as the frame under them, feathered out at
     the edges, so a fraction of a degree reads as leaves moving. */
  .leaves {
    width: calc(var(--w) / var(--crop-w) * 100%);
    height: auto;
    max-width: none;
  }

  .leaves.left {
    --x: 0;
    --y: 0;
    --w: 0.36;
    transform-origin: 40% 100%;
  }

  .leaves.right {
    --x: 0.76;
    --y: 0;
    --w: 0.24;
    transform-origin: 100% 0;
  }

  /* The aircraft light on the far mast. */
  .beacon {
    --x: 0.5128;
    --y: 0.041;
    width: calc(var(--ph) * 0.012);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      oklch(0.72 0.24 25),
      oklch(0.6 0.24 25 / 0.5) 38%,
      transparent
    );
    opacity: 0.35;
  }

  /* A crossing signal at the far end of the promenade. */
  .signal {
    --x: 0.1042;
    --y: 0.452;
    width: calc(var(--ph) * 0.0042);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: oklch(0.7 0.22 28);
    box-shadow: 0 0 calc(var(--ph) * 0.006) oklch(0.7 0.22 28 / 0.8);
  }

  /* Two lit windows that someone, now and then, switches off: a patch of the
     wall's own dark over each, on a slow stepped clock. */
  .window {
    background: oklch(0.13 0.02 265);
    box-shadow: 0 0 calc(var(--ph) * 0.004) calc(var(--ph) * 0.001) oklch(0.13 0.02 265);
    opacity: 0;
  }

  .window.one {
    --x: 0.3843;
    --y: 0.196;
    width: calc(var(--ph) * 0.0125);
    height: calc(var(--ph) * 0.031);
  }

  .window.two {
    --x: 0.4515;
    --y: 0.163;
    width: calc(var(--ph) * 0.0165);
    height: calc(var(--ph) * 0.016);
  }

  /* The lamps on the wall breathe a little, as sodium lamps do. */
  .glow {
    width: calc(var(--ph) * 0.3);
    height: calc(var(--ph) * 0.34);
    translate: -50% -12%;
    background: radial-gradient(closest-side, oklch(0.86 0.11 78 / 0.2), transparent);
    opacity: 0;
  }

  .glow.one {
    --x: 0.403;
    --y: 0.326;
  }

  .glow.two {
    --x: 0.614;
    --y: 0.314;
  }

  .glow.three {
    --x: 0.761;
    --y: 0.303;
  }

  @media (prefers-reduced-motion: no-preference) {
    .stage[data-state='running'] .leaves.left {
      animation: leaves-left 11s ease-in-out infinite alternate;
    }
    .stage[data-state='running'] .leaves.right {
      animation: leaves-right 8.5s ease-in-out infinite alternate;
    }
    .stage[data-state='running'] .beacon {
      animation: beacon 3600ms ease-in-out infinite;
    }
    .stage[data-state='running'] .signal {
      animation: signal 31s steps(1, end) infinite;
    }
    .stage[data-state='running'] .window.one {
      animation: window 67s steps(1, end) infinite;
    }
    .stage[data-state='running'] .window.two {
      animation: window 89s steps(1, end) -31s infinite;
    }
    .stage[data-state='running'] .glow {
      animation: lamp 7600ms ease-in-out infinite alternate;
    }
    .stage[data-state='running'] .glow.two {
      animation-duration: 9100ms;
      animation-delay: -3s;
    }
    .stage[data-state='running'] .glow.three {
      animation-duration: 6400ms;
      animation-delay: -5s;
    }
  }

  @keyframes leaves-left {
    from {
      transform: rotate(-0.16deg) translate(-0.12%, 0);
    }
    to {
      transform: rotate(0.2deg) translate(0.14%, 0.05%);
    }
  }

  @keyframes leaves-right {
    from {
      transform: rotate(0.24deg) translate(0, -0.1%);
    }
    to {
      transform: rotate(-0.2deg) translate(-0.16%, 0.12%);
    }
  }

  @keyframes beacon {
    0%,
    58%,
    100% {
      opacity: 0.22;
    }
    74% {
      opacity: 1;
    }
  }

  @keyframes signal {
    0% {
      background: oklch(0.7 0.22 28);
      box-shadow: 0 0 calc(var(--ph) * 0.006) oklch(0.7 0.22 28 / 0.8);
    }
    56% {
      background: oklch(0.8 0.19 150);
      box-shadow: 0 0 calc(var(--ph) * 0.006) oklch(0.8 0.19 150 / 0.8);
    }
  }

  @keyframes window {
    0% {
      opacity: 0;
    }
    62% {
      opacity: 0.94;
    }
