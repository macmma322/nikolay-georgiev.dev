<script>
  import {
    observeFooterScenario,
    resolveInitialScenario,
    type FooterScenario,
  } from '@/scripts/street/scenario';
  import type { Street } from '@/scripts/street/scene';

  const root = document.querySelector<HTMLElement>('[data-street]');
  const stage = root?.querySelector<HTMLElement>('[data-stage]');
  const back = root?.querySelector<HTMLCanvasElement>('[data-layer="back"]');
  const front = root?.querySelector<HTMLCanvasElement>('[data-layer="front"]');
  const eyebrow = root?.querySelector<HTMLElement>('[data-scene-eyebrow]');
  const castLabel = root?.querySelector<HTMLElement>('[data-cast-label]');
  const meBtn = root?.querySelector<HTMLElement>('[data-me]');
  const desc = root?.querySelector<HTMLElement>('[data-scene-desc]');

  if (
    root &&
    stage &&
    back &&
    front &&
    'IntersectionObserver' in window &&
    'ResizeObserver' in window
  ) {
    const initial = resolveInitialScenario();
    let currentScenario: FooterScenario = initial.scenario;
    let activeInstance: Street | undefined;
    let nearReached = false;
    let mountToken = 0;

    function syncStaticMeta(scenario: FooterScenario) {
      root!.dataset['scene'] = scenario;
      stage!.dataset['scene'] = scenario;
      root!.dataset['sceneReady'] = '';
      if (eyebrow) {
        eyebrow.textContent =
          scenario === 'cafe'
            ? (root!.dataset['labelCafe'] ?? eyebrow.textContent)
            : (root!.dataset['labelStreet'] ?? eyebrow.textContent);
      }
      if (castLabel) {
        castLabel.textContent =
          scenario === 'cafe'
            ? (root!.dataset['castCafe'] ?? castLabel.textContent)
            : (root!.dataset['castStreet'] ?? castLabel.textContent);
      }
      if (meBtn) {
        meBtn.setAttribute(
          'aria-label',
          scenario === 'cafe'
            ? (root!.dataset['meCafe'] ?? meBtn.getAttribute('aria-label') ?? '')
            : (root!.dataset['meStreet'] ?? meBtn.getAttribute('aria-label') ?? ''),
        );
      }
      if (desc) {
        desc.textContent =
          scenario === 'cafe'
            ? (root!.dataset['descCafe'] ?? desc.textContent)
            : (root!.dataset['descStreet'] ?? desc.textContent);
      }
    }

    syncStaticMeta(currentScenario);

    async function mountScenario(scenario: FooterScenario, withDissolve: boolean) {
      const token = ++mountToken;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Stop and release previous scene resources before switching.
      if (activeInstance) {
        activeInstance.destroy();
        activeInstance = undefined;
      }

      const opts = {
        stage: stage!,
        back: back!,
        front: front!,
        avatar: meBtn ?? null,
        counter: root!.querySelector<HTMLElement>('[data-street-count]'),
        cast: Array.from(root!.querySelectorAll<HTMLElement>('[data-cast]')),
        reduce,
        ...(initial.seed === undefined ? {} : { seed: initial.seed }),
      };

      // 2. Prepare and decode incoming scene module & assets.
      if (scenario === 'cafe') {
        const mod = await import('@/scripts/street/cafe');
        if (withDissolve) {
          await mod.loadCafeAtlas().catch(() => null);
        }
        if (token !== mountToken) return;
        syncStaticMeta('cafe');
        if (withDissolve && !reduce) {
          stage!.animate([{ opacity: 0.22 }, { opacity: 1 }], {
            duration: 220,
            easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
          });
        }
        const cafe = mod.createCafe(opts);
        activeInstance = cafe;
        root!.dataset['ready'] = '';
        const win = window as unknown as {
          __street?: Street;
          __cafe?: typeof cafe;
        };
        if (initial.testing) win.__street = cafe;
        win.__cafe = cafe;
      } else {
        const mod = await import('@/scripts/street/scene');
        if (withDissolve) {
          await mod.loadForegroundCrowdAtlas().catch(() => null);
        }
        if (token !== mountToken) return;
        syncStaticMeta('street');
        if (withDissolve && !reduce) {
          stage!.animate([{ opacity: 0.22 }, { opacity: 1 }], {
            duration: 220,
            easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
          });
        }
        const street = mod.createStreet(opts);
        activeInstance = street;
        root!.dataset['ready'] = '';
        const win = window as unknown as {
          __street?: Street;
          __cafe?: undefined;
        };
        if (initial.testing) win.__street = street;
        delete win.__cafe;
      }
    }

    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        near.disconnect();
        nearReached = true;
        void mountScenario(currentScenario, false).catch(() => {
          // Static backdrop remains usable if chunk loading fails.
        });
      },
      { rootMargin: '240px 0px' },
    );
    near.observe(stage);

    observeFooterScenario((nextScenario) => {
      if (nextScenario === currentScenario) return;
      currentScenario = nextScenario;
      if (!nearReached) {
        syncStaticMeta(nextScenario);
        return;
      }
      void mountScenario(nextScenario, true).catch(() => {});
    });
  }
</script>

