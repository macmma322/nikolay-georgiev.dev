---
import { boardPackages, type SceneId } from '@/lib/machine-board';

interface Props {
  scene: SceneId;
}
const { scene } = Astro.props;
const packages = boardPackages(scene);
const r = (n: number) => Math.round(n * 10) / 10;
const rectPath = (x: number, y: number, w: number, h: number) =>
  `M${r(x)} ${r(y)}h${r(w)}v${r(h)}h${r(-w)}z`;
const edges = (height: number) => Array.from({ length: 7 }, (_, i) => ((i + 1) * height) / 8);
const contacts = (width: number, height: number) =>
  edges(height)
    .map((y) => rectPath(-15, y - 3.4, 18, 6.8) + rectPath(width - 3, y - 3.4, 18, 6.8))
    .join('');
const solder = (width: number, height: number) =>
  edges(height)
    .map((y) => `M-13 ${r(y - 2)}h9m${width + 8} 0h9`)
    .join('');
const ids = {
  case: `pcb-case-${scene}`,
  metal: `pcb-metal-${scene}`,
  inset: `pcb-inset-${scene}`,
};
---

<defs>
  <linearGradient id={ids.case} x2="0.8" y2="1">
    <stop stop-color="#4a4845" />
    <stop offset=".2" stop-color="#262529" />
    <stop offset=".72" stop-color="#17171a" />
    <stop offset="1" stop-color="#0c0d0f" />
  </linearGradient>
  <linearGradient id={ids.metal} x2="0" y2="1">
    <stop stop-color="#9f7c57" />
    <stop offset=".3" stop-color="#b89d79" />
    <stop offset=".56" stop-color="#705542" />
    <stop offset="1" stop-color="#3d2b21" />
  </linearGradient>
  <linearGradient id={ids.inset} x2=".9" y2="1">
    <stop stop-color="#4c4946" />
    <stop offset=".53" stop-color="#313033" />
    <stop offset="1" stop-color="#141518" />
  </linearGradient>
</defs>

<g class="packages" aria-hidden="true">
  {packages.map(([x, y, w, h, kind, label], index) => (
    <g class="package" transform={`translate(${x} ${y})`}>
      <rect x="-14" y="-13" width={w + 28} height={h + 27} rx="5" class="footprint" />
      <rect x="-4" y="5" width={w + 11} height={h + 12} rx="7" class="shadow" />
      <path class="contact" d={contacts(w, h)} />
      <path class="solder" d={solder(w, h)} />
      {kind === 'processor' &&
        Array.from({ length: 12 }, (_, i) => ((i + 1) * w) / 13).map((px) => (
          <path class="socket-pin" d={`M${px},-2v-10m0,${h + 14}v10`} />
        ))}
      <rect
        width={w}
        height={h}
        rx={kind === 'processor' ? 6 : 3}
        class="ic-case"
        fill={`url(#${ids.case})`}
      />
      <path class="bevel" d={`M4 ${h - 6}V6Q4 4 7 4H${w - 6}`} />
      <rect
        x="9"
        y="9"
        width={w - 18}
        height={h - 18}
        rx="4"
        fill={`url(#${ids.inset})`}
        class="ic-face"
      />
      {kind === 'heatsink' &&
        Array.from({ length: 12 }, (_, i) => (
          <g>
            <rect
              x={12 + (i * (w - 24)) / 12}
              y="12"
              width={(w - 34) / 12}
              height={h - 24}
              fill={`url(#${ids.metal})`}
              class="fin"
            />
            <path class="fin-edge" d={`M${13 + (i * (w - 24)) / 12},15v${h - 32}`} />
          </g>
        ))}
      {kind === 'connector' && (
        <g>
          <rect
            x="14"
            y="11"
            width={w - 28}
            height={h - 22}
            rx="3"
            fill="#121214"
            stroke="#7f6b55"
          />
          {Array.from({ length: 6 }, (_, i) => 22 + (i * (w - 44)) / 5).map((px) => (
            <path d={`M${px} ${h * 0.32}v${h * 0.36}`} class="header-pin" />
          ))}
        </g>
      )}
      {kind === 'radio' && <path d={`M20,23H${w - 22}v8H24v8h${w - 48}v8H28`} class="antenna" />}
      <circle cx="15" cy="15" r="2.1" class="pin-one" />
      <text x="14" y={h - 17} class="part-label">
        {label}
      </text>
      <g data-detail>
        <path
          class="smd-pad"
          d={Array.from({ length: 5 }, (_, i) =>
            rectPath(8 + i * 19, h + 19 + (i % 2) * 12, 16, 7),
          ).join('')}
        />
        <path
          class="passive"
          d={Array.from({ length: 5 }, (_, i) =>
            rectPath(12 + i * 19, h + 20 + (i % 2) * 12, 8, 5),
          ).join('')}
        />
      </g>
      <g transform={`translate(${w + 26} ${Math.max(8, h - 18)})`}>
        <circle r="4.8" class="led-holder" />
        <circle r="2.0" class:list={['led-core', { violet: index % 3 === 2 }]} />
      </g>
    </g>
  ))}
</g>

<style>
  .packages {
    transform-box: fill-box;
    transform-origin: center;
    transform: translateY(calc((1 - var(--pcb-activation, 0.82)) * 9px));
    opacity: calc(0.57 + var(--pcb-activation, 0.82) * 0.43);
  }

  .footprint {
    fill: #252123;
    stroke: #8b67494d;
    stroke-width: 0.8;
  }
  .shadow {
    fill: #070609b8;
  }
  .contact {
    fill: #94745e;
  }
  .solder {
    fill: none;
    stroke: #d0a77f9b;
    stroke-width: 0.8;
  }
  .socket-pin,
  .header-pin {
    stroke: #a78a63;
    stroke-width: 2;
  }
  .ic-case {
    stroke: #77716a;
    stroke-width: 1.1;
  }
  .bevel {
    fill: none;
    stroke: #d4ccc153;
    stroke-width: 1;
  }
  .ic-face {
    stroke: #0b0b0c;
    stroke-width: 1.3;
  }
  .fin {
    opacity: 0.71;
  }
  .fin-edge {
    stroke: #e8c79c55;
  }
  .antenna {
    fill: none;
    stroke: #b17b53;
    stroke-width: 2.2;
  }
  .pin-one {
    fill: #b5a797;
  }
  .part-label {
    fill: #c6b39f;
    font: 600 10px var(--ff-mono);
    letter-spacing: 0.13em;
    paint-order: stroke fill;
    stroke: #17161a;
    stroke-width: 1.7;
  }
  .smd-pad {
    fill: #94745e;
  }
  .passive {
    fill: #363131;
  }
  .led-holder {
    fill: #2a2322;
    stroke: #997a59;
    stroke-width: 0.6;
  }
  .led-core {
    fill: #f4ad75;
    opacity: calc(0.37 + var(--pcb-nodes, 0.2) * 0.6);
  }
  .led-core.violet {
    fill: #b494c9;
  }
  @media (max-width: 45rem) {
    [data-detail] {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .packages {
      transform: none;
      opacity: 0.9;
    }
  }
</style>
