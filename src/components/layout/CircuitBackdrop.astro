---
import { circuitHeight, circuitWidth, makeCircuitBoard } from '@/lib/circuit-board';
import { machineTraces, type SceneId } from '@/lib/machine-board';
import CircuitPackages from './CircuitPackages.astro';

interface Props {
  place: 'footer' | 'panel' | 'accent' | 'world';
  scene?: SceneId;
}

const { place, scene } = Astro.props;
const seed = place === 'footer' ? 3219 : 1207;
const traces = scene ? machineTraces(scene, seed) : makeCircuitBoard(seed);
const tones = ['copper', 'amber', 'violet'];
const banks = tones.map((name, tone) => {
  const group = traces.filter((trace) => trace.tone === tone);
  return {
    name,
    path: group
      .map(({ points }) => 'M' + points.map((point) => point.join(',')).join('L'))
      .join(''),
    pads: group
      .map(({ points }) => {
        const [x, y] = points.at(-1)!;
        return `M${Math.round(x * 10 - 28) / 10},${Math.round(y * 10) / 10}a2.8,2.8 0 1 0 5.6,0a2.8,2.8 0 1 0 -5.6,0z`;
      })
      .join(''),
  };
});
---

<circuit-field data-place={place} data-scene={scene} data-seed={seed} aria-hidden="true">
  <svg
    viewBox={`0 0 ${circuitWidth} ${circuitHeight}`}
    preserveAspectRatio="xMidYMid slice"
    focusable="false"
  >
    {banks.map(({ name, path, pads }) => (
      <g class:list={['bank', name]}>
        <path d={path} />
        <path class="pads" d={pads} />
      </g>
    ))}
    {scene && <CircuitPackages scene={scene} />}
  </svg>
  {place !== 'accent' && <canvas></canvas>}
</circuit-field>

<script>
  import '@/scripts/circuit-field';
</script>

<style>
  circuit-field {
    position: relative;
    display: block;
    isolation: isolate;
    overflow: clip;
    pointer-events: none;
  }

  circuit-field[data-place='footer'] {
    height: clamp(6rem, 15vw, 13rem);
    border-bottom: 1px solid #b583591d;
    background:
      radial-gradient(ellipse at 54% 110%, #52342c5e, transparent 64%),
      radial-gradient(ellipse at 10% 0%, #30223a51, transparent 52%), #0d0b0d;
  }

  :global([data-stage]) > circuit-field[data-place='footer'] {
    position: absolute;
    inset: 0 0 auto;
    height: 80%;
    border: 0;
    background: none;
    opacity: 0.8;
    mask-image: linear-gradient(black 4%, black 67%, transparent 92%);
  }

  circuit-field[data-place='world'] {
    height: clamp(6.5rem, 12vw, 12.5rem);
    border-block: 1px solid #98725223;
    background:
      radial-gradient(ellipse at 53% 50%, #4c373244, transparent 68%),
      linear-gradient(111deg, #131116, #161417 55%, #0e1013);
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  circuit-field[data-place='world'] .bank {
    opacity: calc(0.57 + var(--pcb-activation, 0.82) * 0.43);
  }

  circuit-field[data-place='world'] .bank path {
    opacity: 0.56;
  }

  circuit-field[data-scene='processor'] {
    position: absolute;
    inset: auto 0 2.5rem;
    z-index: -1;
    height: clamp(15rem, 30vw, 27rem);
    border: 0;
    background:
      radial-gradient(ellipse at 73% 37%, #4a393b4d, transparent 67%),
      linear-gradient(124deg, #121016, #1b161a 60%, #101014);
    opacity: 0.6;
    mask-image:
      linear-gradient(90deg, transparent 36%, #0004 58%, black 86%, #000b),
      linear-gradient(180deg, transparent, black 22%, black 71%, transparent);
    mask-composite: intersect;
  }

  circuit-field[data-scene='transmission'] {
    height: clamp(6.5rem, 13vw, 11rem);
    background: linear-gradient(180deg, #201813, #141317 62%, #0b0b0e);
  }

  @media (max-width: 52rem) {
    circuit-field[data-scene='processor'] {
      inset: auto 0 4rem;
      height: 20rem;
      opacity: 0.54;
      mask-image: linear-gradient(147deg, transparent 15%, black 70%, transparent 98%);
    }
  }

  circuit-field[data-place='panel'] {
    position: absolute;
    inset: 0 0 auto;
    height: 100%;
    mask-image: linear-gradient(90deg, transparent 55%, black 100%);
    opacity: 0.63;
  }

  circuit-field[data-place='accent'] {
    height: 2.8rem;
    margin-bottom: var(--space-s);
    opacity: 0.42;
    mask-image: linear-gradient(90deg, transparent 3%, black 29%, black 79%, transparent 100%);
  }

  svg,
  canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .bank {
    --trace: #af795b;
    fill: none;
    stroke: var(--trace);
    stroke-width: 0.9;
  }

  .amber {
    --trace: #c3915d;
  }

  .violet {
    --trace: #8e73ac;
  }

  .bank path {
    opacity: 0.34;
    vector-effect: non-scaling-stroke;
  }

  .bank .pads {
    fill: #160f13;
    stroke-width: 1;
    opacity: 0.64;
  }

  @media (prefers-reduced-motion: reduce) {
    canvas {
      display: none;
    }
  }
</style>
