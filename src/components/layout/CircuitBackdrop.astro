---
import {
  backdropHeight,
  circuitHeight,
  circuitWidth,
  makeBackdropBoard,
  makeCircuitBoard,
} from '@/lib/circuit-board';

interface Props {
  place: 'background' | 'footer' | 'panel';
}

const { place } = Astro.props;
const background = place === 'background';
const height = background ? backdropHeight : circuitHeight;
const seed = place === 'footer' ? 3219 : 1207;
const traces = background ? makeBackdropBoard(seed) : makeCircuitBoard(seed);
const tones = ['copper', 'amber', 'violet'];
const banks = tones.map((name, tone) => {
  const group = traces.filter((trace) => trace.tone === tone);
  return {
    name,
    path: group
      .map(({ points }) => 'M' + points.map((point) => point.join(',')).join('L'))
      .join(''),
    pads: group
      .map(({ points }) => {
        const [x, y] = points.at(-1)!;
        return `M${Math.round(x * 10 - 28) / 10},${Math.round(y * 10) / 10}a2.8,2.8 0 1 0 5.6,0a2.8,2.8 0 1 0 -5.6,0z`;
      })
      .join(''),
  };
});
---

<circuit-field data-place={place} data-seed={seed} aria-hidden="true">
  <svg
    viewBox={`0 0 ${circuitWidth} ${height}`}
    preserveAspectRatio="xMidYMid slice"
    focusable="false"
  >
    {banks.map(({ name, path, pads }) => (
      <g class:list={['bank', name]}>
        <path d={path} />
        <path class="pads" d={pads} />
      </g>
    ))}
  </svg>
  <canvas></canvas>
</circuit-field>

<script>
  import '@/scripts/circuit-field';
</script>

<style>
  circuit-field {
    position: relative;
    display: block;
    isolation: isolate;
    overflow: clip;
    pointer-events: none;
  }

  circuit-field[data-place='footer'] {
    height: clamp(6rem, 15vw, 13rem);
    border-bottom: 1px solid #b583591d;
    background:
      radial-gradient(ellipse at 54% 110%, #52342c5e, transparent 64%),
      radial-gradient(ellipse at 10% 0%, #30223a51, transparent 52%), #0d0b0d;
  }

  :global([data-stage]) > circuit-field[data-place='footer'] {
    position: absolute;
    inset: 0 0 auto;
    height: 80%;
    border: 0;
    background: none;
    opacity: 0.8;
    mask-image: linear-gradient(black 4%, black 67%, transparent 92%);
  }

  circuit-field[data-place='background'] {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(
      ellipse 100% 82% at 50% 53%,
      black 10%,
      #000d 48%,
      #0004 83%,
      transparent
    );
  }

  circuit-field[data-place='background'] .bank {
    --trace: #bf4f38;
  }

  circuit-field[data-place='background'] .amber {
    --trace: #ad654a;
  }

  circuit-field[data-place='background'] .violet {
    --trace: #766479;
  }

  circuit-field[data-place='background'] .bank path {
    opacity: 0.39;
  }

  circuit-field[data-place='background'] .bank .pads {
    opacity: 0.56;
    fill: #703529;
  }

  @media (max-width: 42rem) {
    circuit-field[data-place='background'] {
      opacity: 0.73;
    }
  }

  circuit-field[data-place='panel'] {
    position: absolute;
    inset: 0 0 auto;
    height: 100%;
    mask-image: linear-gradient(90deg, transparent 55%, black 100%);
    opacity: 0.63;
  }

  svg,
  canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .bank {
    --trace: #af795b;
    fill: none;
    stroke: var(--trace);
    stroke-width: 0.9;
  }

  .amber {
    --trace: #c3915d;
  }

  .violet {
    --trace: #8e73ac;
  }

  .bank path {
    opacity: 0.34;
    vector-effect: non-scaling-stroke;
  }

  .bank .pads {
    fill: #160f13;
    stroke-width: 1;
    opacity: 0.64;
  }

  @media (prefers-reduced-motion: reduce) {
    canvas {
      display: none;
    }
  }
</style>
