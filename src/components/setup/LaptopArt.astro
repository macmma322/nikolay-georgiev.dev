---
/** The Linux laptop, schematic: a screen with a terminal, the parts on the base. */
import Mark from './Mark.astro';
---

<svg class="setup-art" viewBox="0 0 400 300" focusable="false">
  <g data-part="nitro">
    <rect class="ink" x="76" y="20" width="248" height="160" rx="7"></rect>
    <polygon class="ink" points="52,186 348,186 376,250 24,250"></polygon>
    <Mark n={1} x={346} y={34} />
  </g>

  <g data-part="l-os">
    <rect class="screen" x="88" y="32" width="224" height="136"></rect>
    <path class="faint" d="M100 52h70M100 66h120M100 80h96M100 94h140M100 108h60"></path>
    <rect class="key" x="166" y="104" width="7" height="9"></rect>
    <Mark n={5} x={292} y={150} />
  </g>

  <g data-part="l-cpu">
    <rect class="ink" x="96" y="200" width="44" height="26" rx="2"></rect>
    <Mark n={2} x={118} y={240} />
  </g>

  <g data-part="l-gpu">
    <rect class="ink" x="166" y="200" width="60" height="26" rx="2"></rect>
    <Mark n={3} x={196} y={240} />
  </g>

  <g data-part="l-ram">
    <rect class="ink" x="252" y="200" width="18" height="26" rx="1"></rect>
    <rect class="ink" x="274" y="200" width="18" height="26" rx="1"></rect>
    <Mark n={4} x={272} y={240} />
  </g>
</svg>
