---
import { PAGE, type Page } from '@/lib/cv/layout';

/**
 * One CV page drawn as SVG from the same layout the PDF is written from.
 * Text stays text (selectable, read in the PDF's order); the CSS turns
 * kerning, ligatures and localized forms off, as the PDF has them, so every
 * line breaks the same and Bulgarian keeps the PDF's letterforms.
 */
interface Props {
  page: Page;
  photo: string;
  label: string;
}

const { page, photo, label } = Astro.props;
const weight = { regular: 400, semibold: 600, bold: 700 } as const;
const r = (n: number) => Math.round(n * 100) / 100;
const items = page.items;
---

<svg
  class="sheet"
  viewBox={`0 0 ${PAGE.w} ${PAGE.h}`}
  role="group"
  aria-label={label}
  xmlns="http://www.w3.org/2000/svg"
>
  {items.map((it, i) => {
    if (it.t === 'rect') {
      return <rect x={r(it.x)} y={r(it.y)} width={r(it.w)} height={r(it.h)} fill={it.color} />;
    }
    if (it.t === 'image') {
      return <image href={photo} x={it.x} y={it.y} width={it.w} height={it.h} />;
    }
    if (it.t === 'link') return null;
    const text = (
      <text
        x={r(it.x)}
        y={r(it.y)}
        font-size={it.size}
        font-weight={weight[it.font]}
        fill={it.color}
      >
        {it.text}
      </text>
    );
    const next = items[i + 1];
    return next?.t === 'link' ? <a href={next.url}>{text}</a> : text;
  })}
</svg>

<style>
  .sheet {
    display: block;
    inline-size: 100%;
    block-size: auto;
    background: #fff;
    font-family: 'CV Sans', sans-serif;
    font-kerning: none;
    font-variant-ligatures: none;
    font-feature-settings:
      'kern' 0,
      'liga' 0,
      'clig' 0,
      'calt' 0,
      'locl' 0;
    white-space: pre;
  }
  .sheet a:focus-visible text {
    text-decoration: underline;
  }
</style>
