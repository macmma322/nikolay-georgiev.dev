---
import { education as allEducation, roles as allRoles } from '@/data/experience';
import { useI18n } from '@/i18n';
import { period } from '@/i18n/format';
import { home } from '@/i18n/ui/home';

interface Props {
  full?: boolean;
  /** The About page lists education in its own section. */
  showEducation?: boolean;
}
const { full = false, showEducation = true } = Astro.props;
const { locale, t } = useI18n(Astro);
const s = t(home.experience);
const roles = t(allRoles);
const education = t(allEducation);
// Month and year never part at a line end, so a closed period wraps at its join.
const when = (start: string, end: string | undefined) =>
  period(start, end, locale).replace(/(\S) (\d{4})/g, '$1 $2');
---

<div class="exp">
  <ol class:list={['roles', { 'roles-end': !showEducation }]} role="list">
    {roles.map((r) => (
      <li class:list={['role', `is-${r.kind}`]}>
        <p class="when label">
          <span class="period">{when(r.start, r.end)}</span>
          <span class="kind">{s[r.kind]}</span>
        </p>
        <div>
          <h3>
            {r.title}
            <span class="org">&nbsp;· {r.org}</span>
          </h3>
          <p class="place">{r.place}</p>
          <ul role="list" class="points">
            {(full ? r.points : r.points.slice(0, 2)).map((pt) => (
              <li>{pt}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>

  {showEducation && (
    <div class="edu">
      <p class="label">{s.education}</p>
      <ul role="list">
        {(full ? education : education.slice(0, 1)).map((e) => (
          <li>
            <span class="edu-title">{e.title}</span>
            <span class="muted">
              {e.org}, {e.period}
            </span>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<style>
  .roles {
    display: grid;
    border-top: 1px solid var(--line-soft);
  }

  .role {
    display: grid;
    gap: 0.4rem var(--space-xl);
    padding-block: var(--space-m) var(--space-l);
    border-bottom: 1px solid var(--line-soft);
  }

  /* Without the education row, the next section's rule closes the list. */
  .roles-end .role:last-child {
    border-bottom: 0;
  }

  .when {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    padding-top: 0.4rem;
    /* Dates are machine values: tighter tracking keeps the longest on one line in 12rem */
    letter-spacing: 0.08em;
  }

  .kind {
    color: var(--fg-3);
  }

  .is-employment .kind {
    color: var(--steel);
  }

  .role h3 {
    font-size: var(--step-2);
    font-stretch: var(--wide-2);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-heading);
  }

  .org {
    color: var(--fg-2);
    font-weight: var(--w-medium);
  }

  .is-employment .org {
    color: var(--fg);
  }

  .place {
    margin-top: 0.3rem;
    font-size: var(--text-caption);
    color: var(--fg-3);
  }

  .points {
    margin-top: var(--space-s);
    display: grid;
    gap: 0.45rem;
    max-width: 68ch;
  }

  .points li {
    position: relative;
    padding-inline-start: 1.2rem;
    font-size: var(--text-caption);
    line-height: 1.62;
    color: var(--fg-2);
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 8px;
    height: 1px;
    background: var(--line-strong);
  }

  .edu {
    display: grid;
    gap: 0.4rem var(--space-xl);
    padding-block: var(--space-m);
  }

  .edu ul {
    display: grid;
    gap: 0.4rem;
  }

  .edu li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
    align-items: baseline;
  }

  .edu-title {
    font-family: var(--ff-display);
    font-stretch: var(--wide-1);
    font-weight: var(--w-semibold);
  }

  .edu .muted {
    font-size: var(--text-caption);
  }

  /* Dates and the kind of work hang in the margin; the text column stays one edge */
  @media (min-width: 900px) {
    .role,
    .edu {
      grid-template-columns: 12rem minmax(0, 1fr);
    }

    .when {
      flex-direction: column;
    }

    .edu .label {
      padding-top: 0.2rem;
    }
  }
</style>
