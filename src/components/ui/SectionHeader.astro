---
/**
 * Two tiers of section heading.
 *   primary    the home "Selected work" title: a large slogan
 *   secondary  every other section (home and About): a quieter title
 * The optional "more" link sits in the eyebrow row, right-aligned. It follows the
 * title in the DOM, so screen readers meet the heading first.
 */
interface Props {
  label: string;
  title: string;
  id: string;
  tier?: 'primary' | 'secondary';
  lede?: string;
  link?: { href: string; label: string };
  class?: string;
}
const { label, title, id, tier = 'secondary', lede, link, class: className } = Astro.props;
---

<header class:list={['section-header', tier, className]}>
  <p class="label eyebrow">{label}</p>
  <h2 id={id} class="title">
    {title}
  </h2>
  {lede && <p class="lede">{lede}</p>}
  {link && (
    <a class="more" href={link.href}>
      <span class="more-label">{link.label}</span>
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </a>
  )}
</header>

<style>
  /* The eyebrow takes its full width first; the link gets what is left and
     wraps (never below its longest word), so a long Bulgarian link label
     cannot squeeze the eyebrow. */
  .section-header {
    display: grid;
    grid-template-columns: minmax(auto, max-content) minmax(min-content, 1fr);
    align-items: center;
    column-gap: var(--space-m);
    padding-top: var(--space-2xs);
    border-top: 1px solid var(--line-soft);
    margin-bottom: var(--space-xl);
  }

  .eyebrow {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    gap: 1rem;
    min-height: 44px;
    align-items: center;
  }

  /* No link: the eyebrow has the whole row. */
  .section-header:not(:has(.more)) .eyebrow {
    grid-column: 1 / -1;
  }

  .title {
    grid-column: 1 / -1;
    margin-top: var(--space-2xs);
    font-stretch: var(--wide-3);
    font-weight: var(--w-bold);
    text-wrap: balance;
  }

  /* Primary: the one large slogan, two lines at 1366 */
  .primary .title {
    font-size: var(--step-4);
    letter-spacing: var(--track-display);
    line-height: 0.94;
    max-width: 24ch;
  }

  /* Secondary: a step below the project names, never competing with them */
  .secondary .title {
    font-size: var(--step-3);
    letter-spacing: var(--track-heading);
    line-height: 1;
    max-width: 22ch;
  }

  .lede {
    grid-column: 1 / -1;
    margin-top: var(--space-s);
    font-size: var(--step-0);
    line-height: 1.62;
    max-width: 52ch;
  }

  .more {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    text-align: end;
    /* Room inside the focus ring for the arrow's nudge */
    padding-inline-end: var(--space-3xs);
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
    color: var(--fg-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .more-label {
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .more:is(:hover, :focus-visible) {
    color: var(--fg);
  }

  .more:is(:hover, :focus-visible) .more-label {
    text-decoration-color: var(--line-strong);
  }

  .arrow {
    transition: translate var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .more:hover .arrow {
      translate: 3px 0;
    }
  }

  .more:focus-visible .arrow {
    translate: 3px 0;
  }
</style>
