---
import { useI18n } from '@/i18n';
import { avatar } from '@/i18n/ui/avatar';
const copy = useI18n(Astro).t(avatar);
---
<avatar-runtime data-dismiss={copy.dismiss} data-music={copy.lines.music}>
  <button type="button" data-avatar-toggle aria-pressed="true" hidden>{copy.motion}</button>
</avatar-runtime>
<script>
  import '@/scripts/avatar/runtime';
</script>
<style>
  button {
    padding: .5rem 0;
    min-height: 44px;
    background: transparent;
    border: 0;
    color: var(--fg-2);
    font: inherit;
    font-size: var(--text-caption);
    cursor: pointer;
  }
  button::before {
    content: '';
    display: inline-block;
    width: .48em;
    height: .48em;
    margin-inline-end: .55em;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  button[aria-pressed='true']::before { background: currentColor; }
  button:disabled { cursor: default; }
</style>
