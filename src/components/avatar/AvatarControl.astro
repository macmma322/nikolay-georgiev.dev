---
import { useI18n } from '@/i18n';
import { avatar } from '@/i18n/ui/avatar';
const copy = useI18n(Astro).t(avatar);
---

<avatar-runtime
  data-dismiss={copy.dismiss}
  data-music={copy.lines.music}
  data-scene-street={copy.sceneStreet}
  data-scene-cafe={copy.sceneCafe}
  data-switch-cafe={copy.switchToCafe}
  data-switch-street={copy.switchToStreet}
>
  <button type="button" data-avatar-toggle aria-pressed="true" hidden>
    {copy.motion}
  </button>
  <button
    type="button"
    class="scene-switch"
    data-scene-toggle
    aria-label={copy.switchToCafe}
    hidden
  >
    {copy.sceneStreet}
  </button>
</avatar-runtime>
<script>
  import '@/scripts/avatar/runtime';
</script>
<style>
  avatar-runtime {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 1.15rem;
  }
  button {
    padding: 0.5rem 0;
    min-height: 44px;
    background: transparent;
    border: 0;
    color: var(--fg-2);
    font: inherit;
    font-size: var(--text-caption);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  button:is(:hover, :focus-visible) {
    color: var(--fg);
  }
  [data-avatar-toggle]::before {
    content: '';
    display: inline-block;
    width: 0.48em;
    height: 0.48em;
    margin-inline-end: 0.55em;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  [data-avatar-toggle][aria-pressed='true']::before {
    background: currentColor;
  }
  .scene-switch {
    min-inline-size: 13ch;
    text-align: start;
  }
  .scene-switch::before {
    content: '◈';
    display: inline-block;
    margin-inline-end: 0.45em;
    font-size: 0.85em;
    color: var(--fg-3);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .scene-switch:is(:hover, :focus-visible)::before {
    color: var(--fg);
  }
  button:disabled {
    cursor: default;
  }
</style>
