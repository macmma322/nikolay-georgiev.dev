---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExperienceBrief from '@/components/home/ExperienceBrief.astro';
import Capabilities from '@/components/home/Capabilities.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';
import portrait from '@/assets/media/about/portrait.webp';
import { site } from '@/data/site';
import { certificates, education } from '@/data/experience';
import { useI18n } from '@/i18n';
import { common } from '@/i18n/ui/common';
import { about } from '@/i18n/ui/about';

const { l, t, href } = useI18n(Astro);
const c = t(common);
const a = t(about);
const bg = a.background;

// t() resolves localized fields and leaves plain strings as they are.
const background = [
  {
    label: bg.education,
    items: t(education).map((e) => ({ title: e.title, note: `${e.org}, ${e.period}` })),
  },
  {
    label: bg.certificates,
    items: t(certificates).map((cert) => ({ title: cert.title, note: cert.org })),
  },
  {
    label: bg.languages,
    items: site.languages.map((lang) => ({ title: l(lang.name), note: l(lang.level) })),
  },
];
---

<BaseLayout>
  <section class="container intro" aria-labelledby="about-h1">
    <div class="intro-copy">
      <p class="label">{a.label}</p>
      <h1 id="about-h1" class="title" data-vt-lang="title">
        {a.title}
      </h1>
      <div class="bio">
        <p data-vt-lang="lede">
          {a.bio.intro.before}
          <strong>{a.bio.intro.name}</strong>
          {a.bio.intro.after}
        </p>
        <p>{a.bio.own}</p>
        <p>{a.bio.next}</p>
      </div>
      <div class="actions">
        <Button href={site.cv.href} download="Nikolay-Georgiev-CV.pdf" icon="down">
          {c.downloadCv}
          {a.cvLang && (
            <span class="cv-lang" aria-hidden="true">
              {a.cvLang}
            </span>
          )}
          <span class="visually-hidden">{c.pdfDownload}</span>
        </Button>
        <Button href={href('/contact')} variant="secondary">
          {c.getInTouch}
        </Button>
      </div>
    </div>
    {/*
      The photo is mounted like a print: a hairline frame and a graphite mat.
      The crop keeps the full head and shoulders undistorted.
    */}
    <figure class="portrait">
      <div class="print">
        <div class="grade">
          <Image
            src={portrait}
            alt={a.portraitAlt}
            widths={[360, 540, 720]}
            sizes="(min-width: 1000px) 24rem, 80vw"
            loading="eager"
          />
        </div>
      </div>
      <figcaption>
        <span>{l(site.location)}</span>
        <span>{l(site.availability)}</span>
      </figcaption>
    </figure>
  </section>

  <section class="container section split" aria-labelledby="principles-title">
    <div class="rail">
      <SectionHeader label={a.principles.label} id="principles-title" title={a.principles.title} />
    </div>
    <ul class="principles" role="list">
      {a.principles.items.map((p) => (
        <li class="reveal">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container section" aria-labelledby="history-title">
    <SectionHeader label={a.history.label} id="history-title" title={a.history.title} />
    <div class="reveal">
      <ExperienceBrief full showEducation={false} />
    </div>
  </section>

  <section class="container section section-near split" aria-labelledby="facts-title">
    <div class="rail">
      <SectionHeader label={bg.label} id="facts-title" title={bg.title} />
    </div>
    <div class="facts">
      {background.map((col) => (
        <div class="fact-col reveal">
          <h3 class="label">{col.label}</h3>
          <ul role="list">
            {col.items.map((it) => (
              <li>
                <span class="f-title">{it.title}</span>
                <span class="f-note">{it.note}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="capabilities" class="container section section-far" aria-labelledby="caps-title">
    <SectionHeader label={a.capabilities.label} id="caps-title" title={a.capabilities.title} />
    <div class="reveal">
      <Capabilities />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Intro ---------- */
  .intro {
    display: grid;
    gap: var(--space-xl);
    padding-top: var(--space-2xl);
    align-items: start;
  }

  .title {
    margin-top: var(--space-s);
    font-size: var(--step-5);
    font-stretch: var(--wide-3);
    font-weight: var(--w-bold);
    letter-spacing: var(--track-display);
    line-height: 0.95;
    max-width: 14ch;
  }

  .bio {
    margin-top: var(--space-l);
    display: grid;
    gap: 1em;
    max-width: 64ch;
    color: var(--fg-2);
  }

  .bio strong {
    color: var(--fg);
    font-weight: var(--w-semibold);
  }

  /* The CV is English only: a quiet language tag on Bulgarian pages */
  .cv-lang {
    margin-inline-start: 0.5em;
    font-family: var(--ff-mono);
    font-size: 0.75em;
    letter-spacing: 0.06em;
    opacity: 0.72;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-l);
  }

  /* Phones: two equal, full-width actions, as in the hero */
  @media (max-width: 479px) {
    .actions {
      display: grid;
    }
  }

  .portrait {
    margin: 0;
    width: min(72%, 18rem);
  }

  /* Hairline frame and a graphite mat, like a mounted print */
  .print {
    padding: 0.45rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    background: var(--ink-1);
  }

  /*
   * Full colour, gently dimmed so the white backdrop is not the brightest
   * thing on a dark page.
   */
  .grade :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 40%;
    filter: brightness(0.9);
  }

  .portrait figcaption {
    display: grid;
    gap: 0.1rem;
    margin-top: var(--space-xs);
    font-size: var(--text-caption);
    line-height: 1.45;
    color: var(--fg-3);
  }

  .portrait figcaption span:first-child {
    color: var(--fg-2);
  }

  /* Tablets: a small print beside the copy; desktops: a larger one */
  @media (min-width: 700px) {
    .intro {
      grid-template-columns: minmax(0, 1fr) clamp(11rem, 24vw, 14rem);
    }

    .portrait {
      width: 100%;
      margin-top: calc(var(--space-s) + 1.5rem);
    }
  }

  @media (min-width: 1000px) {
    .intro {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }

    .portrait {
      justify-self: end;
      width: min(100%, 22rem);
    }
  }

  /* ---------- Sections: rhythm varies with how related they are ---------- */
  .section {
    padding-top: var(--space-2xl);
  }

  .section-near {
    padding-top: var(--space-xl);
  }

  /* Margin, not padding: a jump to #capabilities lands on the rule, not on
     a blank band above it. */
  .section-far {
    padding-top: 0;
    margin-top: var(--space-3xl);
  }

  /*
   * Rail sections: from 1000px the header sits in a left column and the
   * content's hairlines start on the same line as the header's rule.
   */
  @media (min-width: 1000px) {
    .split {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--space-xl);
      align-items: start;
    }
  }

  /* ---------- Principles: an unboxed 2x2, one hairline per rule ---------- */
  .principles {
    display: grid;
    gap: var(--space-l) var(--space-xl);
  }

  .principles li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: var(--space-s);
    border-top: 1px solid var(--line-soft);
  }

  .principles h3 {
    font-size: var(--step-1);
    font-stretch: var(--wide-2);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-heading);
  }

  .principles p {
    max-width: 46ch;
    color: var(--fg-2);
  }

  @media (min-width: 700px) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Background facts ---------- */
  .facts {
    display: grid;
    gap: var(--space-l) var(--space-xl);
  }

  .fact-col {
    padding-top: var(--space-s);
    border-top: 1px solid var(--line-soft);
  }

  .facts ul {
    margin-top: var(--space-s);
    display: grid;
    gap: var(--space-s);
  }

  .facts li {
    display: grid;
    gap: 0.15rem;
  }

  .f-title {
    font-family: var(--ff-display);
    font-stretch: var(--wide-1);
    font-weight: var(--w-semibold);
    line-height: 1.3;
  }

  .f-note {
    font-size: var(--text-caption);
    color: var(--fg-3);
    line-height: 1.45;
  }

  @media (min-width: 700px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
