---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ArchitectureDiagram from '@/components/diagrams/ArchitectureDiagram.astro';
import Explorer from '@/components/setup/Explorer.astro';
import DeskArt from '@/components/setup/DeskArt.astro';
import InsideArt from '@/components/setup/InsideArt.astro';
import SecondaryArt from '@/components/setup/SecondaryArt.astro';
import LaptopArt from '@/components/setup/LaptopArt.astro';
import { setupEcosystem } from '@/data/diagrams/setup';
import { setupConnections, setupFuture, setupHardware } from '@/data/diagrams/setup-views';
import {
  decisions,
  parts,
  partsIn,
  reuseLimits,
  roadmap,
  secondaryRoles,
  tools,
  type Stage,
} from '@/data/setup';
import { useI18n } from '@/i18n';
import { setup } from '@/i18n/ui/setup';
import { getProjects } from '@/lib/projects';

const { locale, t, href } = useI18n(Astro);
const u = t(setup);
const projects = await getProjects(locale);
const project = (slug: string) => projects.find((p) => p.id === slug);
const stages = Object.keys(roadmap) as Stage[];
const workstation = parts.filter((p) => p.view === 'desk' || p.view === 'inside');
/** The ecosystem's four views; Projects opens first, as before. */
const ecoViews = [
  ['hardware', setupHardware],
  ['connections', setupConnections],
  ['projects', setupEcosystem],
  ['future', setupFuture],
] as const;
---

<BaseLayout>
  <section class="container intro" aria-labelledby="setup-h1">
    <p class="label">{u.eyebrow}</p>
    <h1 id="setup-h1" class="title" data-vt-lang="title">
      {u.title}
    </h1>
    <p class="lede" data-vt-lang="lede">
      {u.lede}
    </p>
    <p class="disclosure">{u.disclosure}</p>
  </section>

  <section id="workstation" class="container group" aria-labelledby="g-workstation">
    <SectionHeader
      label={u.workstation.label}
      id="g-workstation"
      title={u.workstation.title}
      lede={u.workstation.lede}
    />
    <Explorer
      id="workstation"
      views={[
        { view: 'desk', label: u.explorer.desk, art: DeskArt },
        {
          view: 'inside',
          label: u.explorer.insidePc,
          art: InsideArt,
          modes: ['cutaway', 'exploded'],
        },
      ]}
      parts={workstation}
    />
    <p class="schematic label">{u.schematic}</p>
  </section>

  <section id="secondary" class="container group" aria-labelledby="g-secondary">
    <SectionHeader
      label={u.secondary.label}
      id="g-secondary"
      title={u.secondary.title}
      lede={u.secondary.lede}
    />
    <Explorer
      id="secondary"
      views={[
        {
          view: 'secondary',
          label: u.secondary.label,
          art: SecondaryArt,
          modes: ['cutaway', 'exploded'],
          upgrade: true,
        },
      ]}
      parts={partsIn('secondary')}
    />
    <div class="two-lists reveal">
      <div>
        <h3 class="label">{u.secondary.roles}</h3>
        <ul role="list" class="dashed-list">
          {secondaryRoles.map((role) => (
            <li>{t(role)}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="label">{u.secondary.limits}</h3>
        <ul role="list" class="plain-list">
          {reuseLimits.map((limit) => (
            <li>{t(limit)}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="laptop" class="container group" aria-labelledby="g-laptop">
    <SectionHeader
      label={u.laptop.label}
      id="g-laptop"
      title={u.laptop.title}
      lede={u.laptop.lede}
    />
    <Explorer
      id="laptop"
      views={[{ view: 'laptop', label: u.laptop.label, art: LaptopArt, modes: ['cutaway'] }]}
      parts={partsIn('laptop')}
    />
  </section>

  <section id="ecosystem" class="container group" aria-labelledby="g-ecosystem">
    <SectionHeader
      label={u.ecosystem.label}
      id="g-ecosystem"
      title={u.ecosystem.title}
      lede={u.ecosystem.lede}
    />
    <div class="eco">
      <fieldset class="eco-switch">
        <legend class="visually-hidden">{u.ecosystem.view}</legend>
        {ecoViews.map(([key], i) => (
          <label>
            <input type="radio" name="eco-view" value={key} checked={i === 2} />
            <span>{u.ecosystem.modes[key]}</span>
          </label>
        ))}
      </fieldset>
      {ecoViews.map(([key, diagram]) => (
        <div class="eco-pane" data-eco={key}>
          <ArchitectureDiagram diagram={diagram} todayHref="#workstation" nextHref="#roadmap" />
        </div>
      ))}
    </div>
  </section>

  <section id="journey" class="container group" aria-labelledby="g-journey">
    <SectionHeader label={u.journey.label} id="g-journey" title={u.journey.title} />
    <div class="areas reveal">
      {u.journey.areas.map((area) => {
        const target = area.slug ? project(area.slug) : undefined;
        return (
          <article class="area" data-accent={target?.data.accent}>
            <h3 class="area-title">{area.title}</h3>
            <p>{area.body}</p>
            {target ? (
              <a class="area-link" href={href(`/work/${area.slug}`)}>
                {u.journey.caseStudy}: {target.data.name}
                <span aria-hidden="true">→</span>
              </a>
            ) : (
              <a class="area-link" href={href('/open-source#blueprint')}>
                {u.journey.blueprint}
                <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section id="decisions" class="container group" aria-labelledby="g-decisions">
    <SectionHeader
      label={u.decisions.label}
      id="g-decisions"
      title={u.decisions.title}
      lede={u.decisions.lede}
    />
    <div class="decisions">
      {decisions.map((d) => {
        const target = project(d.project);
        return (
          <article
            class="decision reveal"
            data-accent={target?.data.accent}
            aria-labelledby={`d-${d.id}`}
          >
            <h3 id={`d-${d.id}`} class="d-title">
              {t(d.title)}
            </h3>
            <dl class="steps">
              {d.steps.map((step, i) => (
                <div>
                  <dt class="label">{u.decisions.steps[i]}</dt>
                  <dd>{t(step)}</dd>
                </div>
              ))}
            </dl>
            {target && (
              <a class="area-link" href={href(`/work/${d.project}`)}>
                {u.decisions.caseStudy}: {target.data.name}
                <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section id="environment" class="container group" aria-labelledby="g-tools">
    <SectionHeader label={u.tools.label} id="g-tools" title={u.tools.title} lede={u.tools.lede} />
    <ul role="list" class="tools reveal">
      {tools.map((tool) => (
        <li class:list={['tool', `usage-${tool.usage}`]}>
          <span class="tool-name">{tool.name}</span>
          <span class="tool-what">{t(tool.what)}</span>
          <span class="tool-usage label">{u.tools.usage[tool.usage]}</span>
        </li>
      ))}
    </ul>
    <p class="tools-more">
      <a href={href('/open-source#blueprint')}>
        {u.tools.blueprint}
        <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>

  <section id="roadmap" class="container group" aria-labelledby="g-roadmap">
    <SectionHeader
      label={u.roadmap.label}
      id="g-roadmap"
      title={u.roadmap.title}
      lede={u.roadmap.lede}
    />
    <div class="stages reveal">
      {stages.map((stage) => (
        <section class:list={['stage', `stage-${stage}`]} aria-labelledby={`s-${stage}`}>
          <h3 id={`s-${stage}`} class="label">
            {u.roadmap.stages[stage]}
          </h3>
          <ul role="list">
            {roadmap[stage].map((m) => (
              <li>
                <span class="m-item">{t(m.item)}</span>
                {m.why && <span class="m-why">{t(m.why)}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section class="container group closing" aria-labelledby="g-next">
    <h2 id="g-next" class="closing-title">
      {u.next.title}
    </h2>
    <div class="closing-actions">
      <Button href={href('/work')}>{u.next.work}</Button>
      <Button href={href('/open-source')} variant="secondary">
        {u.next.openSource}
      </Button>
      <Button href={href('/about')} variant="ghost">
        {u.next.about}
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Ecosystem views: native radios, one diagram at a time ---------- */
  .eco-switch {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-m);
    padding: 0;
    border: 0;
  }

  .eco-switch label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    color: var(--fg-2);
    cursor: pointer;
  }

  .eco-switch label:has(:checked) {
    border-color: var(--fg-2);
    color: var(--fg);
  }

  .eco-switch label:has(:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .eco-switch input {
    accent-color: var(--fg);
  }

  /* Without :has() every view stacks, which is still complete. */
  .eco:has(.eco-switch) .eco-pane {
    display: none;
  }

  .eco:has(input[value='hardware']:checked) [data-eco='hardware'],
  .eco:has(input[value='connections']:checked) [data-eco='connections'],
  .eco:has(input[value='projects']:checked) [data-eco='projects'],
  .eco:has(input[value='future']:checked) [data-eco='future'] {
    display: block;
  }

  .intro {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-l);
    container-type: inline-size;
  }

  .title {
    margin-top: var(--space-s);
    font-size: var(--step-hero);
    font-stretch: var(--wide-3);
    font-weight: var(--w-heavy);
    letter-spacing: -0.05em;
    line-height: 0.88;
  }

  .title:lang(bg) {
    font-size: min(var(--step-hero), 15cqi);
  }

  .intro .lede {
    margin-top: var(--space-m);
  }

  .disclosure {
    margin-top: var(--space-m);
    max-width: 62ch;
    padding-left: var(--space-s);
    border-left: 2px solid var(--line-strong);
    font-size: var(--text-caption);
    color: var(--fg-2);
  }

  .group {
    padding-top: var(--space-2xl);
  }

  .schematic {
    margin-top: var(--space-s);
  }

  /* ---------- Secondary PC lists ---------- */
  .two-lists {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-l);
  }

  @media (min-width: 52rem) {
    .two-lists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .two-lists ul {
    display: grid;
    gap: var(--space-2xs);
    margin-top: var(--space-xs);
    color: var(--fg-2);
  }

  .two-lists li {
    padding-left: var(--space-s);
    border-left: 1px solid var(--line);
  }

  .dashed-list li {
    border-left-style: dashed;
  }

  /* ---------- Journey ---------- */
  .areas {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 52rem) {
    .areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .areas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .area {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-m);
    border-top: 2px solid var(--accent);
    background: var(--ink-1);
    color: var(--fg-2);
  }

  .area-title,
  .d-title {
    font-size: var(--step-1);
    font-stretch: var(--wide-2);
    font-weight: var(--w-bold);
    color: var(--fg);
  }

  .area-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin-top: auto;
    color: var(--fg);
  }

  .area-link:is(:hover, :focus-visible) {
    color: var(--accent);
  }

  /* ---------- Decisions ---------- */
  .decisions {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 60rem) {
    .decisions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .decision {
    padding: var(--space-m);
    border: 1px solid var(--line-soft);
    border-top: 2px solid var(--accent);
    border-radius: var(--radius-s);
    background: var(--ink-1);
  }

  .steps {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-s);
  }

  .steps div {
    display: grid;
    gap: var(--space-3xs);
  }

  @media (min-width: 40rem) {
    .steps div {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: var(--space-s);
    }
  }

  .steps dd {
    color: var(--fg-2);
  }

  /* ---------- Tools ---------- */
  .tools {
    display: grid;
    border-top: 1px solid var(--line-soft);
  }

  .tool {
    display: grid;
    gap: var(--space-3xs) var(--space-m);
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--line-soft);
  }

  @media (min-width: 48rem) {
    .tool {
      grid-template-columns: minmax(0, 5fr) minmax(0, 5fr) 11rem;
      align-items: baseline;
    }
  }

  .tool-name {
    color: var(--fg);
    font-weight: var(--w-medium);
  }

  .tool-what {
    color: var(--fg-2);
  }

  .usage-idle :is(.tool-name, .tool-what) {
    color: var(--fg-3);
  }

  .tools-more {
    margin-top: var(--space-m);
  }

  .tools-more a {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 44px;
    color: var(--fg);
  }

  /* ---------- Roadmap ---------- */
  .stages {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 52rem) {
    .stages {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .stages {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .stage {
    padding-top: var(--space-xs);
    border-top: 2px solid var(--fg-2);
  }

  /* Further from today, fainter and dashed: the diagrams' vocabulary. */
  .stage-building {
    border-top-color: var(--fg-3);
  }

  .stage-past {
    border-top-color: var(--line);
  }

  .stage-planned,
  .stage-vision {
    border-top-style: dashed;
    border-top-color: var(--line-strong);
  }

  .stage ul {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-s);
  }

  .m-item {
    display: block;
    color: var(--fg);
  }

  .m-why {
    display: block;
    margin-top: var(--space-3xs);
    font-size: var(--text-caption);
    color: var(--fg-3);
  }

  .stage-vision .m-item,
  .stage-past .m-item {
    color: var(--fg-2);
  }

  /* ---------- Closing ---------- */
  .closing-title {
    font-size: var(--step-3);
    font-stretch: var(--wide-3);
    font-weight: var(--w-bold);
    letter-spacing: var(--track-heading);
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-m);
  }
</style>
