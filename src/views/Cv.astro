---
/**
 * The CV page: a preview of the CV in both languages, drawn at build time
 * from the same layout as the PDF, and a Generate button that writes the PDF
 * in the browser (src/scripts/cv.ts). The ready-made PDFs are always linked,
 * so the page works without JavaScript and when generation fails.
 */
import regular from '@expo-google-fonts/tiktok-sans/400Regular/TikTokSans_400Regular.ttf?url';
import semibold from '@expo-google-fonts/tiktok-sans/600SemiBold/TikTokSans_600SemiBold.ttf?url';
import bold from '@expo-google-fonts/tiktok-sans/700Bold/TikTokSans_700Bold.ttf?url';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CvSheet from '@/components/cv/CvSheet.astro';
import { LOCALES, LOCALE_META, useI18n } from '@/i18n';
import { plural } from '@/i18n/format';
import { cvPage } from '@/i18n/ui/cv';
import { fontBytes } from '@/lib/cv/assets';
import { layout } from '@/lib/cv/layout';
import { cvDocs } from '@/lib/cv/load';
import { measurer } from '@/lib/cv/pdf';
import { styleHash } from '@/lib/csp';

const { locale, t } = useI18n(Astro);
const u = t(cvPage);
const docs = await cvDocs();
const measure = measurer(await fontBytes());
const photo = '/cv-portrait.jpg';
const fonts = { regular, semibold, bold };
// Reading order: this page's language first.
const order = [locale, ...LOCALES.filter((l) => l !== locale)];
const previews = order.map((l) => ({ locale: l, doc: docs[l], pages: layout(docs[l], measure) }));

const fontCss = Object.entries({ 400: regular, 600: semibold, 700: bold })
  .map(
    ([weight, url]) =>
      `@font-face{font-family:'CV Sans';src:url(${url}) format('truetype');font-weight:${weight};font-display:block}`,
  )
  .join('');
Astro.csp?.insertStyleHash(styleHash(fontCss));
const json = JSON.stringify(docs).replace(/</g, '\\u003c');
---

<BaseLayout>
  <Fragment slot="head">
    {Object.values(fonts).map((url) => (
      <link rel="preload" href={url} as="font" type="font/ttf" crossorigin />
    ))}
    <style set:html={fontCss}></style>
  </Fragment>

  <section class="container intro" aria-labelledby="cv-h1">
    <p class="label">{u.label}</p>
    <h1 id="cv-h1" class="title" data-vt-lang="title">
      {u.title}
    </h1>
    <p class="lede" data-vt-lang="lede">
      {u.lede}
    </p>
  </section>

  <section
    class="container cv"
    data-cv
    data-fonts={JSON.stringify(fonts)}
    data-photo={photo}
    data-busy={u.busy}
    data-done={u.done}
    aria-label={u.label}
  >
    <div class="panel">
      <fieldset class="langs">
        <legend>{u.language}</legend>
        {order.map((l) => (
          <label>
            <input type="radio" name="cv-lang" value={l} checked={l === locale} />
            <span lang={LOCALE_META[l].lang}>{LOCALE_META[l].name}</span>
          </label>
        ))}
      </fieldset>

      <button class="generate" type="button" data-cv-generate hidden>
        {u.generate}
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path
            d="M8 2.5v9m0 0 3.5-3.5M8 11.5 4.5 8M3 13.5h10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          ></path>
        </svg>
      </button>
      <p class="status" role="status" data-cv-status></p>
      <p class="failed" role="alert" data-cv-failed hidden>
        {u.failed}
      </p>

      <p class="ready">
        {previews.map((p) => (
          <a class="ready-link" data-lang={p.locale} href={`/${p.doc.file}`} download={p.doc.file}>
            {u.ready} · {LOCALE_META[p.locale].short}
            <span class="ready-meta">
              {u.meta.replace('{pages}', plural(p.pages.length, locale, u.pages))}
            </span>
          </a>
        ))}
      </p>

      <h2 class="h">{u.contains.title}</h2>
      <ul class="contains" role="list">
        {u.contains.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <h2 class="h">{u.how.title}</h2>
      <p class="how">{u.how.body}</p>
    </div>

    <div class="previews">
      {previews.map((p) => (
        <div
          class="preview"
          data-lang={p.locale}
          lang={LOCALE_META[p.locale].lang}
          role="region"
          aria-label={u.preview.replace('{lang}', u.langName[p.locale])}
        >
          {p.pages.map((page, i) => (
            <CvSheet
              page={page}
              photo={photo}
              label={u.page
                .replace('{n}', String(i + 1))
                .replace('{total}', String(p.pages.length))}
            />
          ))}
        </div>
      ))}
    </div>
  </section>

  <script type="application/json" id="cv-data" set:html={json} />
  <script>
    import '@/scripts/cv';
  </script>
</BaseLayout>

<style>
  .intro {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-l);
    container-type: inline-size;
  }

  .title {
    margin-top: var(--space-s);
    max-width: 14ch;
    font-size: var(--step-5);
    font-stretch: var(--wide-3);
    font-weight: var(--w-heavy);
    letter-spacing: -0.04em;
    line-height: 0.92;
  }

  .intro .lede {
    margin-top: var(--space-m);
  }

  .cv {
    display: grid;
    gap: var(--space-l);
    padding-bottom: var(--space-2xl);
  }

  @media (min-width: 1000px) {
    .cv {
      grid-template-columns: minmax(16rem, 22rem) 1fr;
      align-items: start;
    }
    .panel {
      position: sticky;
      top: calc(var(--header-h, 4.5rem) + var(--space-s));
    }
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .langs legend {
    margin-bottom: var(--space-2xs);
    font-family: var(--ff-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .langs label {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .langs input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .langs label:has(:checked) {
    border-color: var(--fg);
    background: color-mix(in oklch, var(--fg) 10%, transparent);
  }

  .langs label:has(:checked) span::before {
    content: '';
    display: inline-block;
    width: 0.45em;
    height: 0.45em;
    margin-right: 0.5em;
    background: var(--signal);
    vertical-align: 0.12em;
  }

  .langs label:has(:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .generate {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    width: 100%;
    min-height: 52px;
    margin-top: var(--space-m);
    padding: 0 1.15rem;
    border: 1px solid var(--fg);
    border-radius: var(--radius-s);
    background: var(--fg);
    color: var(--ink-0);
    font-family: var(--ff-display);
    font-stretch: var(--wide-1);
    font-weight: var(--w-semibold);
    font-size: 1rem;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      scale var(--dur-press) var(--ease-out);
  }

  .generate[hidden] {
    display: none;
  }

  .generate:is(:hover, :focus-visible) {
    background: color-mix(in oklch, var(--fg), white 70%);
  }

  .generate:active {
    scale: 0.98;
  }

  .generate[aria-disabled='true'] {
    cursor: progress;
    opacity: 0.7;
  }

  .status:not(:empty) {
    margin-top: var(--space-xs);
    font-size: var(--text-caption);
    color: var(--fg-2);
  }

  .failed {
    margin-top: var(--space-xs);
    padding-left: var(--space-s);
    border-left: 2px solid var(--signal);
    font-size: var(--text-caption);
  }

  .ready {
    margin-top: var(--space-s);
  }

  .ready-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--space-2xs) 0;
    font-weight: var(--w-medium);
  }

  .ready-meta {
    font-size: var(--text-label);
    font-family: var(--ff-mono);
    color: var(--fg-3);
  }

  .h {
    margin-top: var(--space-l);
    font-family: var(--ff-mono);
    font-size: var(--text-label);
    font-weight: var(--w-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .contains {
    margin-top: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .contains li {
    position: relative;
    margin-top: var(--space-2xs);
    padding-left: 1rem;
    font-size: var(--text-caption);
    color: var(--fg-2);
  }

  .contains li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.35rem;
    height: 0.35rem;
    background: var(--steel-dim);
  }

  .how {
    margin-top: var(--space-xs);
    font-size: var(--text-caption);
    color: var(--fg-2);
    max-width: 60ch;
  }

  .previews {
    min-width: 0;
  }

  .preview {
    display: grid;
    gap: var(--space-m);
  }

  .preview :global(.sheet) {
    max-width: 52rem;
    border-radius: 2px;
    box-shadow:
      0 0 0 1px oklch(0 0 0 / 0.4),
      0 18px 48px -18px oklch(0 0 0 / 0.7);
  }

  /* The chosen language's preview and ready-made link; without :has() both show. */
  .cv:has(input[value='en']:checked) [data-lang='bg'],
  .cv:has(input[value='bg']:checked) [data-lang='en'] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .generate,
    .langs label {
      transition: none;
    }
  }
</style>
