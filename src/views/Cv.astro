---
/**
 * The CV page. Previews of the general CV (both languages, both versions) are
 * drawn at build time from the same layout as the PDF; the Generate button
 * writes the PDF in the browser (src/scripts/cv.ts), and Tailor CV to a job
 * matches a pasted job description against the site's evidence, locally.
 * The ready-made PDFs are always linked, so the page works without
 * JavaScript and when generation fails.
 */
import regular from '@expo-google-fonts/tiktok-sans/400Regular/TikTokSans_400Regular.ttf?url';
import semibold from '@expo-google-fonts/tiktok-sans/600SemiBold/TikTokSans_600SemiBold.ttf?url';
import bold from '@expo-google-fonts/tiktok-sans/700Bold/TikTokSans_700Bold.ttf?url';
// The preview's copies: the same fonts subset to Latin, Cyrillic and punctuation as
// WOFF2 (pyftsubset; about 47 kB each instead of 200), so the page paints sooner.
// The glyph advances are unchanged, so the preview still matches the PDF line for line;
// the full TrueType files load only to write a PDF or draw a tailored CV.
import previewRegular from '@/assets/cv/TikTokSans-400Regular.woff2?url';
import previewSemibold from '@/assets/cv/TikTokSans-600SemiBold.woff2?url';
import previewBold from '@/assets/cv/TikTokSans-700Bold.woff2?url';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { cv } from '@/data/cv';
import { LOCALES, LOCALE_META, useI18n } from '@/i18n';
import { plural } from '@/i18n/format';
import { cvPage } from '@/i18n/ui/cv';
import { fontBytes } from '@/lib/cv/assets';
import { cvFile, type Mode } from '@/lib/cv/doc';
import { layout } from '@/lib/cv/layout';
import { cvDocs, cvTerms } from '@/lib/cv/load';
import { measurer } from '@/lib/cv/pdf';
import { sheetSvg } from '@/lib/cv/svg';
import { styleHash } from '@/lib/csp';

const { locale, l, t } = useI18n(Astro);
const u = t(cvPage);
const docs = await cvDocs();
const terms = await cvTerms();
const measure = measurer(await fontBytes());
const photo = '/cv-portrait.jpg';
const fonts = { regular, semibold, bold };
// Reading order: this page's language first.
const order = [locale, ...LOCALES.filter((x) => x !== locale)];
const modes: Mode[] = ['portfolio', 'ats'];
const previews = order.flatMap((lang) =>
  modes.map((mode) => {
    const pages = layout(docs[lang]['general']!, measure, mode);
    const label = (i: number) =>
      u.page.replace('{n}', String(i + 1)).replace('{total}', String(pages.length));
    return {
      lang,
      mode,
      file: cvFile(lang, 'general', mode),
      pages: pages.length,
      svg: pages.map((page, i) => sheetSvg(page, photo, label(i))).join(''),
    };
  }),
);

const preview = { 400: previewRegular, 600: previewSemibold, 700: previewBold };
const fontCss = Object.entries(preview)
  .map(
    ([weight, url]) =>
      `@font-face{font-family:'CV Sans';src:url(${url}) format('woff2');font-weight:${weight};font-display:block}`,
  )
  .join('');
Astro.csp?.insertStyleHash(styleHash(fontCss));
const json = JSON.stringify({ docs, terms }).replace(/</g, '\\u003c');
const strings = {
  busy: u.busy,
  done: u.done,
  updating: u.updating,
  page: u.page,
  empty: u.tailor.empty,
  suggest: u.tailor.suggest,
  use: u.tailor.use,
  applied: u.tailor.applied,
  quote: u.tailor.quote,
  groups: u.tailor.groups,
  targets: Object.fromEntries(cv.targets.map((x) => [x.id, l(x.label)])),
  files: Object.fromEntries(cv.targets.map((x) => [x.id, x.file])),
};
---

<BaseLayout>
  <Fragment slot="head">
    {Object.values(preview).map((url) => (
      <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />
    ))}
    <style set:html={fontCss}></style>
  </Fragment>

  <section class="container intro" aria-labelledby="cv-h1">
    <p class="label">{u.label}</p>
    <h1 id="cv-h1" class="title" data-vt-lang="title">
      {u.title}
    </h1>
    <p class="lede" data-vt-lang="lede">
      {u.lede}
    </p>
  </section>

  <section
    class="container cv"
    data-cv
    data-fonts={JSON.stringify(fonts)}
    data-photo={photo}
    data-strings={JSON.stringify(strings)}
    aria-label={u.label}
  >
    <div class="panel">
      <fieldset class="choice">
        <legend>{u.language}</legend>
        {order.map((x) => (
          <label>
            <input type="radio" name="cv-lang" value={x} checked={x === locale} />
            <span lang={LOCALE_META[x].lang}>{LOCALE_META[x].name}</span>
          </label>
        ))}
      </fieldset>

      <fieldset class="choice versions">
        <legend>{u.version.legend}</legend>
        <label>
          <input type="radio" name="cv-mode" value="portfolio" checked />
          <span>
            {u.version.portfolio}
            <small>{u.version.portfolioNote}</small>
          </span>
        </label>
        <label>
          <input type="radio" name="cv-mode" value="ats" />
          <span>
            {u.version.ats}
            <small>{u.version.atsNote}</small>
          </span>
        </label>
      </fieldset>

      <div class="js-only" data-cv-js hidden>
        <label class="field" for="cv-target">
          {u.target}
        </label>
        <select id="cv-target" class="select" name="cv-target">
          {cv.targets.map((x) => (
            <option value={x.id}>{l(x.label)}</option>
          ))}
        </select>
      </div>

      <button class="generate" type="button" data-cv-generate hidden>
        {u.generate}
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path
            d="M8 2.5v9m0 0 3.5-3.5M8 11.5 4.5 8M3 13.5h10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          ></path>
        </svg>
      </button>
      <p class="status" role="status" data-cv-status></p>
      <p class="failed" role="alert" data-cv-failed hidden>
        {u.failed}
      </p>

      <p class="ready">
        {previews.map((p) => (
          <a
            class="ready-link"
            data-lang={p.lang}
            data-mode={p.mode}
            href={`/${p.file}`}
            download={p.file}
          >
            {u.ready} · {LOCALE_META[p.lang].short} ·{' '}
            {p.mode === 'ats' ? u.version.ats : u.version.portfolio}
            <span class="ready-meta">
              {u.meta.replace('{pages}', plural(p.pages, locale, u.pages))}
            </span>
          </a>
        ))}
      </p>

      <section class="tailor js-only" data-cv-js hidden aria-labelledby="tailor-h">
        <h2 class="h" id="tailor-h">
          {u.tailor.title}
        </h2>
        <p class="note">{u.tailor.intro}</p>
        <label class="field" for="cv-job">
          {u.tailor.field}
        </label>
        <textarea id="cv-job" class="job" rows="6" spellcheck="false"></textarea>
        <div class="row">
          <button class="small" type="button" data-cv-analyse>
            {u.tailor.analyse}
          </button>
          <button class="small ghost" type="button" data-cv-clear>
            {u.tailor.clear}
          </button>
        </div>
        <div class="results" data-cv-results aria-live="polite"></div>
        <p class="note">{u.tailor.noScore}</p>
      </section>

      <h2 class="h">{u.contains.title}</h2>
      <ul class="contains" role="list">
        {u.contains.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <h2 class="h">{u.how.title}</h2>
      <p class="how">{u.how.body}</p>
    </div>

    <div class="previews">
      {previews.map((p) => (
        <div
          class="preview"
          data-lang={p.lang}
          data-mode={p.mode}
          lang={LOCALE_META[p.lang].lang}
          role="region"
          aria-label={u.preview.replace('{lang}', u.langName[p.lang])}
          set:html={p.svg}
        />
      ))}
      <div class="preview live" data-cv-live role="region" aria-live="polite"></div>
    </div>
  </section>

  <script type="application/json" id="cv-data" set:html={json} />
  <script>
    import '@/scripts/cv';
  </script>
</BaseLayout>

<style>
  .intro {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-l);
    container-type: inline-size;
  }

  .title {
    margin-top: var(--space-s);
    max-width: 14ch;
    font-size: var(--step-5);
    font-stretch: var(--wide-3);
    font-weight: var(--w-heavy);
    letter-spacing: -0.04em;
    line-height: 0.92;
  }

  .intro .lede {
    margin-top: var(--space-m);
  }

  .cv {
    display: grid;
    gap: var(--space-l);
    padding-bottom: var(--space-2xl);
  }

  @media (min-width: 1000px) {
    .cv {
      grid-template-columns: minmax(16rem, 22rem) 1fr;
      align-items: start;
    }
  }
  /* Not sticky: with the job tailoring the panel is taller than a screen, and
     a sticky element taller than the viewport hides its own lower part. */

  .choice {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .choice legend {
    margin-bottom: var(--space-2xs);
    font-family: var(--ff-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .choice label {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .choice input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .choice label:has(:checked) {
    border-color: var(--fg);
    background: color-mix(in oklch, var(--fg) 10%, transparent);
  }

  .choice label:has(:checked) span::before {
    content: '';
    display: inline-block;
    width: 0.45em;
    height: 0.45em;
    margin-right: 0.5em;
    background: var(--signal);
    vertical-align: 0.12em;
  }

  .choice label:has(:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .choice + .choice {
    margin-top: var(--space-s);
  }

  .versions label {
    flex: 1 1 10rem;
    padding-block: 0.55rem;
  }

  .versions small {
    display: block;
    font-size: var(--text-label);
    color: var(--fg-3);
  }

  .field {
    display: block;
    margin-top: var(--space-s);
    margin-bottom: var(--space-3xs);
    font-family: var(--ff-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .select,
  .job {
    inline-size: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    background: var(--ink-1);
    color: var(--fg);
    font: inherit;
    font-size: var(--text-caption);
  }

  .select {
    min-height: 44px;
  }

  .job {
    resize: vertical;
    min-height: 8rem;
  }

  .select:focus-visible,
  .job:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .row {
    display: flex;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  .small {
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--fg);
    border-radius: var(--radius-s);
    background: var(--fg);
    color: var(--ink-0);
    font-weight: var(--w-semibold);
    cursor: pointer;
  }

  .small.ghost {
    border-color: var(--line-strong);
    background: transparent;
    color: var(--fg);
  }

  .small:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .note {
    margin-top: var(--space-2xs);
    font-size: var(--text-caption);
    color: var(--fg-3);
  }

  .results :global(.note) {
    margin-top: var(--space-2xs);
    font-size: var(--text-caption);
    color: var(--fg-3);
  }

  .results :global(h3) {
    margin-top: var(--space-s);
    font-size: var(--text-caption);
    font-weight: var(--w-semibold);
  }

  .results :global(ul) {
    margin-top: var(--space-3xs);
    padding: 0;
    list-style: none;
  }

  .results :global(li) {
    margin-top: var(--space-2xs);
    font-size: var(--text-caption);
    color: var(--fg-2);
  }

  .results :global(li b) {
    color: var(--fg);
  }

  .results :global(.q) {
    display: block;
    font-size: var(--text-label);
    color: var(--fg-3);
  }

  .results :global(.suggest) {
    margin-top: var(--space-s);
    font-size: var(--text-caption);
  }

  .results :global(.suggest button) {
    margin-left: 0.5rem;
    padding: 0.2rem 0.6rem;
    min-height: 36px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }

  .tailor {
    margin-top: var(--space-l);
  }

  .preview :global(.sheet) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    background: #fff;
    font-family: 'CV Sans', sans-serif;
    font-kerning: none;
    font-variant-ligatures: none;
    font-feature-settings:
      'kern' 0,
      'liga' 0,
      'clig' 0,
      'calt' 0,
      'locl' 0;
    white-space: pre;
  }

  .generate {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    width: 100%;
    min-height: 52px;
    margin-top: var(--space-m);
    padding: 0 1.15rem;
    border: 1px solid var(--fg);
    border-radius: var(--radius-s);
    background: var(--fg);
    color: var(--ink-0);
    font-family: var(--ff-display);
    font-stretch: var(--wide-1);
    font-weight: var(--w-semibold);
    font-size: 1rem;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      scale var(--dur-press) var(--ease-out);
  }

  .generate[hidden] {
    display: none;
  }

  .generate:is(:hover, :focus-visible) {
    background: color-mix(in oklch, var(--fg), white 70%);
  }

  .generate:active {
    scale: 0.98;
  }

  .generate[aria-disabled='true'] {
    cursor: progress;
    opacity: 0.7;
  }

  .status:not(:empty) {
    margin-top: var(--space-xs);
    font-size: var(--text-caption);
    color: var(--fg-2);
  }

  .failed {
    margin-top: var(--space-xs);
    padding-left: var(--space-s);
    border-left: 2px solid var(--signal);
    font-size: var(--text-caption);
  }

  .ready {
    margin-top: var(--space-s);
  }

  .ready-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--space-2xs) 0;
    font-weight: var(--w-medium);
  }

  .ready-meta {
    font-size: var(--text-label);
    font-family: var(--ff-mono);
    color: var(--fg-3);
  }

  .h {
    margin-top: var(--space-l);
    font-family: var(--ff-mono);
    font-size: var(--text-label);
    font-weight: var(--w-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .contains {
    margin-top: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .contains li {
    position: relative;
    margin-top: var(--space-2xs);
    padding-left: 1rem;
    font-size: var(--text-caption);
    color: var(--fg-2);
  }

  .contains li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.35rem;
    height: 0.35rem;
    background: var(--steel-dim);
  }

  .how {
    margin-top: var(--space-xs);
    font-size: var(--text-caption);
    color: var(--fg-2);
    max-width: 60ch;
  }

  .previews {
    min-width: 0;
  }

  .preview {
    display: grid;
    gap: var(--space-m);
  }

  .preview :global(.sheet) {
    max-width: 52rem;
    border-radius: 2px;
    box-shadow:
      0 0 0 1px oklch(0 0 0 / 0.4),
      0 18px 48px -18px oklch(0 0 0 / 0.7);
  }

  /* The chosen language and version; without :has() every preview shows. */
  .cv:has(input[name='cv-lang'][value='en']:checked) [data-lang='bg'],
  .cv:has(input[name='cv-lang'][value='bg']:checked) [data-lang='en'],
  .cv:has(input[name='cv-mode'][value='portfolio']:checked) [data-mode='ats'],
  .cv:has(input[name='cv-mode'][value='ats']:checked) [data-mode='portfolio'] {
    display: none;
  }

  /* A tailored CV is drawn in the browser; it replaces the built previews. */
  .preview.live,
  .cv[data-custom] .preview:not(.live) {
    display: none;
  }

  .cv[data-custom] .preview.live {
    display: grid;
  }

  .js-only[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .generate,
    .choice label {
      transition: none;
    }
  }
</style>
