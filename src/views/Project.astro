---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatusBadge from '@/components/ui/StatusBadge.astro';
import TechIcon from '@/components/ui/TechIcon.astro';
import LayerGlyph from '@/components/ui/LayerGlyph.astro';
import ArchitectureDiagram from '@/components/diagrams/ArchitectureDiagram.astro';
import ProjectArt from '@/components/work/ProjectArt.astro';
import { diagrams } from '@/data/diagrams';
import { useI18n } from '@/i18n';
import { common } from '@/i18n/ui/common';
import { work } from '@/i18n/ui/work';
import { getProjects, renderProject } from '@/lib/projects';

interface Props {
  slug: string;
}

const { locale, t, href } = useI18n(Astro);
const c = t(common);
const w = t(work).case;
const names = t(work).sections;
const projects = await getProjects(locale);
const at = projects.findIndex((project) => project.id === Astro.props.slug);
const entry = projects[at];
const next = projects[(at + 1) % projects.length];
if (!entry || !next) throw new Error(`Unknown project "${Astro.props.slug}"`);
const index = at + 1;
const p = entry.data;
const { Content } = await renderProject(entry);
const num = String(index).padStart(2, '0');

// Reading order: the diagram and the hard problems come before the inventory.
// The contents lists and the section headings share these names.
type SectionId = keyof typeof names;
const sectionIds: SectionId[] = [
  'overview',
  ...(p.diagrams.length || p.architecture ? (['architecture'] as const) : []),
  ...(p.media.length ? (['media'] as const) : []),
  ...(p.hard.length ? (['hard'] as const) : []),
  ...(p.decisions.length ? (['decisions'] as const) : []),
  'built',
  'status',
  ...(p.learned.length ? (['learned'] as const) : []),
  'stack',
];
const toc = sectionIds.map((id, i) => ({
  id,
  label: names[id],
  n: String(i + 1).padStart(2, '0'),
}));
const sectionNo = (id: SectionId) => toc.find((item) => item.id === id)?.n;

// A narrow image alone in its row (before a wide one, or last) takes the whole
// row with its caption beside it, so the two-column grid never leaves a hole.
let col = 0;
const media = p.media.map((m, i) => {
  if (m.wide) {
    col = 0;
    return { ...m, solo: false };
  }
  const solo = col === 0 && (p.media[i + 1]?.wide ?? true);
  col = col === 0 && !solo ? 1 : 0;
  return { ...m, solo };
});
---

<BaseLayout accent={p.accent}>
  <article class="case">
    <header class="case-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <nav class="crumbs label" aria-label={w.breadcrumb}>
            <ol role="list">
              <li>
                <a href={href('/work')}>{w.work}</a>
              </li>
              <li aria-current="page">{p.name}</li>
            </ol>
          </nav>
          <p class="case-index">
            <span class="accent-tick" aria-hidden="true"></span>
            <span class="label">{w.number(num)}</span>
            <span class="case-kicker">{p.kicker}</span>
          </p>
          <h1 class="case-title" data-vt-title={entry.id}>
            {p.name}
          </h1>
          <p class="case-summary" data-vt-lang="lede">
            {p.summary}
          </p>
          <div class="case-status">
            <StatusBadge status={p.status} note={p.statusNote} size="m" />
          </div>
        </div>
        <div class="hero-art" data-vt-art={entry.id}>
          <ProjectArt slug={entry.id} legend />
        </div>
      </div>

      <div class="container">
        <dl class="meta">
          <div class="meta-role">
            <dt class="label">{w.role}</dt>
            <dd>{p.role}</dd>
          </div>
          <div>
            <dt class="label">{w.timeline}</dt>
            <dd>{p.years}</dd>
          </div>
          <div>
            <dt class="label">{w.context}</dt>
            <dd>{p.context}</dd>
          </div>
          <div>
            <dt class="label">{w.layers}</dt>
            <dd class="meta-layers">
              <LayerGlyph lit={p.layers} />
              <span>{p.layerNames}</span>
            </dd>
          </div>
          <div>
            <dt class="label">{w.links}</dt>
            <dd class="meta-links">
              {p.links.live && (
                <a class="text-link" href={p.links.live} target="_blank" rel="noopener">
                  {p.links.liveLabel ?? w.liveSite}
                  <span class="ext" aria-hidden="true">
                    ↗
                  </span>
                  <span class="visually-hidden"> {c.newTab}</span>
                </a>
              )}
              <span class="muted">{p.links.repoNote}</span>
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="container case-body">
      <nav class="toc-bar" aria-label={w.contents}>
        <details data-toc-bar>
          <summary>
            <span class="label">{w.contents}</span>
            <span class="toc-bar-now">
              <span class="toc-n" data-toc-now-n></span>
              <span class="toc-bar-label" data-toc-now-label></span>
            </span>
            <span class="toc-bar-icon" aria-hidden="true">
              ↓
            </span>
          </summary>
          <ol role="list">
            {toc.map((item) => (
              <li>
                <a
                  class="toc-link"
                  href={`#${item.id}`}
                  data-toc-link={item.id}
                  data-toc-n={item.n}
                  data-toc-label={item.label}
                >
                  <span class="toc-n">{item.n}</span>
                  {item.label}
                </a>
              </li>
            ))}
          </ol>
        </details>
      </nav>

      <nav class="toc" aria-label={w.contents}>
        <p class="label">{w.contents}</p>
        <ol role="list">
          {toc.map((item) => (
            <li>
              <a class="toc-link" href={`#${item.id}`} data-toc-link={item.id}>
                <span class="toc-n">{item.n}</span>
                {item.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="sections" data-case-sections>
        <section id="overview" class="block" aria-labelledby="h-overview">
          <h2 id="h-overview" class="block-title">
            <span class="block-n">{sectionNo('overview')}</span>{' '}
            <span class="block-name">{names.overview}</span>
          </h2>
          <div class="overview-grid">
            <div class="prose">
              <Content />
            </div>
            <div class="spec">
              <p class="spec-head label" id="spec-title">
                {w.spec}
              </p>
              <dl aria-labelledby="spec-title">
                {p.spec.map((row) => (
                  <div class="spec-row">
                    <dt class="label">{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
          <ul
            role="list"
            class:list={['highlights reveal', { 'is-three': p.highlights.length === 3 }]}
          >
            {p.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </section>

        {(p.diagrams.length > 0 || p.architecture) && (
          <section id="architecture" class="block" aria-labelledby="h-architecture">
            <h2 id="h-architecture" class="block-title">
              <span class="block-n">{sectionNo('architecture')}</span>{' '}
              <span class="block-name">{names.architecture}</span>
            </h2>
            <p class="lede arch-lede">{p.architecture}</p>
            <div class="diagrams">
              {p.diagrams.map((id, i) => {
                const d = diagrams[id];
                if (!d) throw new Error(`Unknown diagram ${id}`);
                return (
                  <ArchitectureDiagram
                    diagram={d}
                    figure={w.figure(num, i + 1)}
                    accent={p.accent}
                  />
                );
              })}
            </div>
          </section>
        )}

        {media.length > 0 && (
          <section id="media" class="block" aria-labelledby="h-media">
            <h2 id="h-media" class="block-title">
              <span class="block-n">{sectionNo('media')}</span>{' '}
              <span class="block-name">{names.media}</span>
            </h2>
            <div class="media-grid">
              {media.map((m) => (
                <figure class:list={['media reveal', { wide: m.wide, solo: m.solo }]}>
                  <Image
                    src={m.src}
                    alt={m.alt}
                    widths={m.wide ? [640, 960, 1280, 1920] : [480, 720, 960]}
                    sizes={
                      m.wide ? '(min-width: 1200px) 1100px, 94vw' : '(min-width: 900px) 540px, 94vw'
                    }
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{m.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        {p.hard.length > 0 && (
          <section id="hard" class="block" aria-labelledby="h-hard">
            <h2 id="h-hard" class="block-title">
              <span class="block-n">{sectionNo('hard')}</span>{' '}
              <span class="block-name">{names.hard}</span>
            </h2>
            <ul role="list" class="hard">
              {p.hard.map((h) => (
                <li class:list={['hard-item reveal', { 'has-figure': h.figure }]}>
                  <h3>{h.title}</h3>
                  {h.figure && (
                    <p class="hard-figure">
                      <span class="hard-value">{h.figure.value}</span>
                      <span class="hard-figure-label">{h.figure.label}</span>
                    </p>
                  )}
                  <div class="hard-cols">
                    <div>
                      <p class="label">{w.problem}</p>
                      <p>{h.problem}</p>
                    </div>
                    <div>
                      <p class="label">{w.solution}</p>
                      <p>{h.solution}</p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}

        {p.decisions.length > 0 && (
          <section id="decisions" class="block" aria-labelledby="h-decisions">
            <h2 id="h-decisions" class="block-title">
              <span class="block-n">{sectionNo('decisions')}</span>{' '}
              <span class="block-name">{names.decisions}</span>
            </h2>
            <dl class="decisions">
              {p.decisions.map((d) => (
                <div class="decision reveal">
                  <dt>{d.decision}</dt>
                  <dd>{d.why}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <section id="built" class="block" aria-labelledby="h-built">
          <h2 id="h-built" class="block-title">
            <span class="block-n">{sectionNo('built')}</span>{' '}
            <span class="block-name">{names.built}</span>
          </h2>
          <div class="built">
            {p.built.map((group) => (
              <div class="built-group reveal">
                <h3>{group.title}</h3>
                <ul role="list">
                  {group.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section id="status" class="block" aria-labelledby="h-status">
          <h2 id="h-status" class="block-title">
            <span class="block-n">{sectionNo('status')}</span>{' '}
            <span class="block-name">{names.status}</span>
          </h2>
          <div class="status-grid">
            <div class="status-col" id="today">
              <h3 class="label">{w.today}</h3>
              <ul role="list">
                {p.now.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            {p.next.length > 0 && (
              <div class="status-col is-next" id="next">
                <h3 class="label">{w.next}</h3>
                <ul role="list">
                  {p.next.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          {p.notes.length > 0 && (
            <div class="notes reveal">
              <p class="label">{w.notes}</p>
              {p.notes.map((n) => (
                <p>{n}</p>
              ))}
            </div>
          )}
        </section>

        {p.learned.length > 0 && (
          <section id="learned" class="block" aria-labelledby="h-learned">
            <h2 id="h-learned" class="block-title">
              <span class="block-n">{sectionNo('learned')}</span>{' '}
              <span class="block-name">{names.learned}</span>
            </h2>
            <ul role="list" class="learned">
              {p.learned.map((l) => (
                <li class="reveal">{l}</li>
              ))}
            </ul>
          </section>
        )}

        <section id="stack" class="block" aria-labelledby="h-stack">
          <h2 id="h-stack" class="block-title">
            <span class="block-n">{sectionNo('stack')}</span>{' '}
            <span class="block-name">{names.stack}</span>
          </h2>
          <ul role="list" class="stack-list reveal">
            {p.stack.map((id) => (
              <li>
                <TechIcon id={id} size="m" />
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    {/*
      The link holds only its words (label, name, kicker); its ::after stretches
      over the whole row, so the plate beside it stays clickable without its
      drawing labels becoming part of the link's name.
    */}
    <nav class="container next reveal" aria-label={w.nextCase} data-vt-scope>
      <div class="next-row" data-accent={next.data.accent}>
        <a href={href(`/work/${next.id}`)} class="next-link">
          <span class="label next-label">{w.nextCase}</span>
          <span class="next-copy">
            <span class="next-name" data-vt-title={next.id}>
              {next.data.name}
            </span>
            <span class="next-kicker">
              {next.data.kicker}
              <span class="next-arrow" aria-hidden="true">
                →
              </span>
            </span>
          </span>
        </a>
        <div class="next-art" data-vt-art={next.id}>
          <ProjectArt slug={next.id} compact />
        </div>
      </div>
    </nav>
  </article>
</BaseLayout>

<script>
  import '@/scripts/case-nav';
</script>

<style>
  /* ---------- Hero ---------- */
  .case-hero {
    padding-top: var(--space-l);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-xl);
    align-items: end;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
  }

  .crumbs li + li::before {
    content: '/';
    margin-inline-end: 0.5rem;
    color: var(--fg-3);
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .crumbs a:is(:hover, :focus-visible) {
    color: var(--fg);
    text-decoration-color: var(--line-strong);
  }

  .case-index {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-top: var(--space-s);
  }

  .accent-tick {
    align-self: center;
    width: 18px;
    height: 2px;
    background: var(--accent);
  }

  .case-kicker {
    font-size: var(--text-caption);
    color: var(--fg-2);
  }

  /* A size container, so the title can be capped by its own column (cqi). */
  .hero-copy {
    container-type: inline-size;
    min-width: 0;
  }

  .case-title {
    width: fit-content;
    max-width: 100%;
    margin-top: var(--space-s);
    font-size: min(clamp(2.6rem, 1rem + 7vw, 7.5rem), 17cqi);
    font-stretch: var(--wide-3);
    font-weight: var(--w-heavy);
    letter-spacing: var(--track-display);
    line-height: 0.9;
    overflow-wrap: anywhere;
  }

  .case-summary {
    margin-top: var(--space-m);
    max-width: 46ch;
    font-family: var(--ff-display);
    font-stretch: var(--wide-1);
    font-size: var(--step-2);
    font-weight: var(--w-text);
    line-height: 1.25;
    letter-spacing: -0.012em;
  }

  /* Beside the plate the summary is a lead paragraph, not a second headline. */
  @media (min-width: 1000px) {
    .case-summary {
      font-size: var(--step-1);
      line-height: 1.35;
    }
  }

  @media (max-width: 479px) {
    .case-summary {
      font-size: var(--step-1);
      line-height: 1.35;
    }
  }

  .case-status {
    margin-top: var(--space-m);
  }

  /* Stacked below 1000px: the plate keeps a readable size, not the full width */
  .hero-art {
    position: relative;
    min-width: 0;
    width: 100%;
    max-width: 34rem;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--space-m);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .meta > div {
    padding: var(--space-s) var(--space-m) var(--space-s) 0;
  }

  .meta-role {
    grid-column: 1 / -1;
  }

  .meta dd {
    margin-top: 0.3rem;
    font-size: var(--text-caption);
    color: var(--fg-2);
  }

  .meta-layers {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .meta-links {
    display: grid;
    justify-items: start;
    gap: 0.1rem;
  }

  /* 44px target, while the line box keeps the cell's rhythm */
  .meta-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 44px;
    margin-block: calc((1lh - 44px) / 2);
  }

  .ext {
    display: inline-block;
    transition: translate var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .meta-links a:hover .ext {
      translate: 2px -2px;
    }
  }

  .meta-links a:focus-visible .ext {
    translate: 2px -2px;
  }

  @media (min-width: 700px) {
    .meta {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .meta-role {
      grid-column: auto;
    }
  }

  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }
    .hero-art {
      max-width: none;
    }
    .meta:not(:lang(bg)) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .meta:not(:lang(bg)) > div + div {
      padding-inline-start: var(--space-m);
      border-inline-start: 1px solid var(--line-soft);
    }
  }

  /*
   * Bulgarian words run longer ('инфраструктурата'): its one row of five waits
   * for 1180px, where every cell holds such a word, and the role (the longest
   * entry) takes a wider cell. Below that it keeps the three-column layout.
   */
  @media (min-width: 1180px) {
    .meta:lang(bg) {
      grid-template-columns: minmax(0, 1.4fr) repeat(4, minmax(0, 1fr));
    }
    .meta:lang(bg) > div + div {
      padding-inline-start: var(--space-m);
      border-inline-start: 1px solid var(--line-soft);
    }
  }

  /* ---------- Body layout ---------- */
  .case-body {
    padding-top: var(--space-l);
  }

  .sections {
    display: grid;
    gap: var(--space-2xl);
    min-width: 0;
  }

  /* One flexible track, so a long heading word cannot widen the section */
  .block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    min-width: 0;
  }

  /*
   * Below 1180px the compact contents bar sticks under the header. Reserve it
   * in the scroll padding, so anchor jumps and keyboard focus (which ignores
   * scroll-margin on ancestors) both land clear of it.
   */
  @media (max-width: 1179.98px) {
    :global(html:has(.toc-bar)) {
      scroll-padding-top: calc(var(--header-h) + 4.25rem);
    }
  }

  .block-title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-top: var(--space-s);
    border-top: 1px solid var(--line-soft);
    font-size: var(--step-3);
    font-stretch: var(--wide-2);
    font-weight: var(--w-bold);
  }

  .block-n {
    font-family: var(--ff-mono);
    font-size: var(--text-label);
    font-weight: 450;
    letter-spacing: 0.1em;
    color: var(--accent);
    translate: 0 -0.5em;
  }

  /* May shrink beside the number, so a long single word wraps instead of overflowing */
  .block-name {
    min-width: 0;
  }

  /*
   * Bulgarian runs longer and has longer single words: headings hyphenate
   * where the browser can, and break a word only if it still cannot fit.
   */
  :is(.block-name, .hard-item h3, .built-group h3, .meta dd):lang(bg) {
    hyphens: auto;
    overflow-wrap: break-word;
  }

  /* ---------- Contents: shared entry ---------- */
  .toc-link {
    --lit: 0;
    --rail: transparent;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    border-inline-start: 1px solid var(--rail);
    font-size: var(--text-caption);
    color: color-mix(in oklch, var(--fg) calc(var(--lit) * 100%), var(--fg-3));
    text-decoration: none;
    transition:
      --lit var(--dur-ui) var(--ease-out),
      border-color var(--dur-ui) var(--ease-out);
  }

  .toc-link:is(:hover, :focus-visible) {
    color: var(--fg);
  }

  /* The section being read is lit; the rail above it is the progress line */
  li:has(~ li > .toc-link[aria-current]) > .toc-link {
    --rail: color-mix(in oklch, var(--accent) 45%, transparent);
  }

  .toc-link[aria-current] {
    --lit: 1;
    --rail: var(--accent);
  }

  @media (forced-colors: active) {
    .toc-link[aria-current] {
      text-decoration: underline;
    }
  }

  .toc-n {
    font-family: var(--ff-mono);
    font-size: var(--text-label);
    color: color-mix(in oklch, var(--accent) calc(var(--lit) * 100%), var(--fg-3));
  }

  /* ---------- Contents: compact bar below 1180px ---------- */
  .toc-bar {
    position: sticky;
    top: var(--header-h);
    z-index: 30;
    margin-inline: calc(-1 * var(--gutter));
    margin-bottom: var(--space-xl);
  }

  .toc-bar details {
    position: relative;
  }

  .toc-bar summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3rem;
    padding-inline: var(--gutter);
    border-block: 1px solid var(--line-soft);
    background: var(--ink-0);
    list-style: none;
    cursor: pointer;
  }

